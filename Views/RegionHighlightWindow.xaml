<Window x:Class="ShineProCS.Views.RegionHighlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" IsHitTestVisible="False">
    <Border x:Name="HighlightBorder" BorderBrush="Red" BorderThickness="3" CornerRadius="2">
        <Border.Effect>
            <DropShadowEffect Color="Red" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>
    </Border>
</Window>
