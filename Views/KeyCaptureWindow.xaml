<ui:FluentWindow x:Class="ShineProCS.Views.KeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="按键捕获" Width="320" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        KeyDown="Window_KeyDown">
    
    <Grid Margin="20,40,20,20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="请按下要绑定的按键" FontSize="16" FontWeight="SemiBold" 
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            
            <Border Background="#333" CornerRadius="8" Padding="20,16" Margin="0,0,0,20">
                <TextBlock x:Name="KeyDisplay" Text="等待按键..." FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
            </Border>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:Button Content="确定" Width="80" Height="32" Margin="0,0,8,0" Click="Confirm_Click" 
                        Appearance="Primary" IsEnabled="False" x:Name="ConfirmBtn"/>
                <ui:Button Content="取消" Width="80" Height="32" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
