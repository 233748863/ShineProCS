<UserControl x:Class="ShineProCS.Views.SkillConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:ShineProCS.Utils"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:local="clr-namespace:ShineProCS.Views">
    
    <UserControl.Resources>
        <utils:KeyCodeToNameConverter x:Key="KeyToName"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧：技能卡片列表 -->
        <ui:Card Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 顶部工具栏 -->
                <StackPanel Grid.Row="0">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="技能配置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ui:Button x:Name="BtnPreset" Content="预设" Height="28" HorizontalAlignment="Right" ToolTip="加载配置预设" Click="LoadPreset_Click"/>
                    </DockPanel>
                    
                    <!-- 方案选择 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfileComboBox" ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfile}"/>
                        <ui:Button Grid.Column="1" Content="+" Width="32" Height="32" Margin="4,0,0,0" ToolTip="新建方案" Click="CreateProfile_Click"/>
                        <ui:Button Grid.Column="2" Content="−" Width="32" Height="32" Margin="4,0,0,0" ToolTip="删除当前方案" Click="DeleteProfile_Click"/>
                    </Grid>
                    
                    <!-- 快捷操作 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="+ 添加" Height="32" HorizontalAlignment="Stretch" Margin="0,0,2,0" Click="AddSkill_Click"/>
                        <ui:Button Grid.Column="1" Content="全部展开" Height="32" HorizontalAlignment="Stretch" Margin="2,0" Click="ExpandAll_Click"/>
                        <ui:Button Grid.Column="2" Content="全部折叠" Height="32" HorizontalAlignment="Stretch" Margin="2,0,0,0" Click="CollapseAll_Click"/>
                    </Grid>
                </StackPanel>
                
                <!-- 技能卡片列表 - 支持拖拽排序，放在中间行以填充剩余空间 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8">
                    <ItemsControl x:Name="SkillCardList" ItemsSource="{Binding Skills}"
                                  dd:DragDrop.IsDragSource="True"
                                  dd:DragDrop.IsDropTarget="True"
                                  dd:DragDrop.UseDefaultDragAdorner="True"
                                  dd:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:SkillCardControl x:Name="SkillCard" Loaded="SkillCard_Loaded"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- 底部保存按钮 -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <ui:Button x:Name="BtnSave" Content="💾 保存配置" Appearance="Primary" Height="40" HorizontalAlignment="Stretch" Click="SaveConfig_Click"/>
                    <TextBlock x:Name="UnsavedHint" Text="* 有未保存的更改" Foreground="#FF9800" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </ui:Card>
        
        <!-- 右侧：实时预览和帮助 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 实时预览区域 -->
            <ui:Card>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="实时预览" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Foreground="#AAA"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="PreviewFps" Text="0 FPS" Foreground="#666" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="AutoPreviewCheck" Content="自动刷新" IsChecked="True" VerticalAlignment="Center" Checked="AutoPreview_Changed" Unchecked="AutoPreview_Changed"/>
                        </StackPanel>
                    </DockPanel>
                    
                    <!-- 预览画面 -->
                    <Border Background="#1A1A1A" CornerRadius="6" MinHeight="180" BorderBrush="#333" BorderThickness="1">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="4"/>
                            <Canvas x:Name="PreviewOverlay" IsHitTestVisible="False"/>
                            
                            <!-- 无选中技能提示 -->
                            <StackPanel x:Name="NoSelectionHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="👆" FontSize="28" HorizontalAlignment="Center" Opacity="0.4"/>
                                <TextBlock Text="选择一个技能查看预览" Foreground="#555" FontSize="13" Margin="0,6,0,0"/>
                                <TextBlock Text="或点击技能卡片的[视觉检测]标签配置" Foreground="#444" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- 预览状态栏 -->
                    <Border DockPanel.Dock="Bottom" Padding="4,6" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PreviewSkillName" Text="技能: --" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                                <Border x:Name="PreviewMatchBadge" Background="#4CAF50" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="PreviewMatchText" Text="匹配: 95%" FontSize="10" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            
                            <TextBlock Grid.Column="1" x:Name="PreviewRegionInfo" Text="区域: --" Foreground="#666" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </ui:Card>
            
            <!-- 快速帮助 -->
            <ui:Card Grid.Row="1" Margin="0,12,0,0">
                <Expander Header="⚡ 快速帮助" IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="配置步骤" FontWeight="Medium" FontSize="12" Foreground="#AAA" Margin="0,0,0,6"/>
                        <TextBlock Text="1. 点击技能卡片展开配置" Foreground="#777" FontSize="12" Margin="0,0,0,3"/>
                        <TextBlock Text="2. 在[视觉检测]标签中点击[一键配置]" Foreground="#777" FontSize="12" Margin="0,0,0,3"/>
                        <TextBlock Text="3. 框选游戏中的技能图标区域" Foreground="#777" FontSize="12" Margin="0,0,0,3"/>
                        <TextBlock Text="4. 系统自动截取模板并测试匹配" Foreground="#777" FontSize="12" Margin="0,0,0,3"/>
                        <TextBlock Text="5. 点击[保存配置]完成" Foreground="#777" FontSize="12"/>
                        
                        <Separator Margin="0,10" Opacity="0.3"/>
                        
                        <TextBlock Text="提示" FontWeight="Medium" FontSize="12" Foreground="#AAA" Margin="0,0,0,6"/>
                        <TextBlock Text="• 确保技能图标处于可用状态再截取" Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3"/>
                        <TextBlock Text="• 匹配度建议保持在80%以上" Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3"/>
                        <TextBlock Text="• 可以拖拽技能卡片调整优先级" Foreground="#666" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
