<Page x:Class="ShineProCS.Views.Pages.SettingsPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:utils="clr-namespace:ShineProCS.Utils"
         Title="设置"
         ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
         ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
         Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- 
    需求 6: 全局设置页
    需求 13.3, 13.4, 13.5: 统一间距、Card组件和SymbolIcon使用
    -->

    <Page.Resources>
        <utils:InverseBooleanConverter x:Key="InvBool"/>
        <utils:KeyCodeToNameConverter x:Key="KeyToName"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <utils:RegionArrayToStringConverter x:Key="RegionArrayToString"/>
        <utils:PointArrayToStringConverter x:Key="PointArrayToString"/>
        <utils:ColorToBrushConverter x:Key="ColorToBrush"/>
    </Page.Resources>

    <!-- 使用 Grid 包裹以确保正确的布局约束 -->
    <!-- 解决 WPF UI 库 NavigationView 内部布局导致 ScrollViewer 的 ViewportHeight 不正确的问题 -->
    <Grid Margin="{StaticResource PageMargin}">
        <!-- 需求 13.3: 使用统一的页面边距 -->
        <ScrollViewer x:Name="MainScrollViewer" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0"
                      CanContentScroll="False">
            <!-- 内容区域：自适应宽度 -->
            <StackPanel>
                <TextBlock Text="全局设置" Style="{StaticResource PageTitleStyle}"/>

            <!-- 需求 6.2: 引擎设置分组 -->
            <!-- 需求 13.4: 使用 Card 组件分组 -->
            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <TextBlock Text="引擎设置" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Margin="{StaticResource SectionMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="循环间隔 (毫秒)" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox x:Name="LoopIntervalTextBox" 
                                        Text="{Binding AppSettings.LoopInterval, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                        PreviewTextInput="NumericTextBox_PreviewTextInput"
                                        LostFocus="LoopIntervalTextBox_LostFocus"/>
                            <TextBlock Text="主循环检测间隔，建议50-200ms" Style="{StaticResource HintTextStyle}"/>
                            <TextBlock x:Name="LoopIntervalError" Style="{StaticResource ValidationErrorStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="图像队列容量" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox x:Name="ImageQueueCapacityTextBox"
                                        Text="{Binding AppSettings.ImageQueueCapacity, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewTextInput="NumericTextBox_PreviewTextInput"
                                        LostFocus="ImageQueueCapacityTextBox_LostFocus"/>
                            <TextBlock Text="图像缓冲队列大小，2-10" Style="{StaticResource HintTextStyle}"/>
                            <TextBlock x:Name="ImageQueueCapacityError" Style="{StaticResource ValidationErrorStyle}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="{StaticResource SectionMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="帧变化检测阈值" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox x:Name="FrameChangeThresholdTextBox"
                                        Text="{Binding AppSettings.FrameChangeThreshold, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewTextInput="NumericTextBox_PreviewTextInput"
                                        LostFocus="FrameChangeThresholdTextBox_LostFocus"/>
                            <TextBlock Text="0=禁用检测，建议10-30" Style="{StaticResource HintTextStyle}"/>
                            <TextBlock x:Name="FrameChangeThresholdError" Style="{StaticResource ValidationErrorStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="模板缓存大小" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox x:Name="TemplateCacheSizeTextBox"
                                        Text="{Binding AppSettings.TemplateCacheSize, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewTextInput="NumericTextBox_PreviewTextInput"
                                        LostFocus="TemplateCacheSizeTextBox_LostFocus"/>
                            <TextBlock Text="模板图片缓存数量，建议20-100" Style="{StaticResource HintTextStyle}"/>
                            <TextBlock x:Name="TemplateCacheSizeError" Style="{StaticResource ValidationErrorStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 需求 6.2: 输入驱动设置分组 -->
            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <TextBlock Text="输入驱动设置" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="选择键盘/鼠标输入方式，GhostBox 为硬件级模拟" Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource SectionMargin}"/>

                    <Grid Margin="{StaticResource SectionMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="驱动类型" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedIndex="{Binding SelectedDriverIndex}" Width="250" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Win32 (软件模拟)"/>
                                <ComboBoxItem Content="GhostBox (硬件驱动)" IsEnabled="{Binding IsGhostBoxAvailable}"/>
                            </ComboBox>
                            <TextBlock Text="Win32 使用系统 API 模拟，GhostBox 使用硬件设备" Style="{StaticResource HintTextStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- GhostBox 连接状态 -->
                    <Border Style="{StaticResource InfoPanelStyle}" 
                            Visibility="{Binding IsGhostBoxSelected, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="{StaticResource SmallMargin}">
                                    <TextBlock Text="连接状态: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding GhostBoxConnectionStatus}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGhostBoxConnected}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding GhostBoxDeviceInfo}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="{StaticResource FontSizeSM}" 
                                           Visibility="{Binding IsGhostBoxConnected, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding GhostBoxErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="{StaticResource FontSizeSM}" TextWrapping="Wrap" 
                                           Visibility="{Binding HasGhostBoxError, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="重新连接" Height="{StaticResource ButtonHeightMD}" VerticalAlignment="Center" 
                                       Command="{Binding ReconnectGhostBoxCommand}" Icon="{ui:SymbolIcon ArrowSync20}"/>
                        </Grid>
                    </Border>

                    <!-- GhostBox 不可用提示 -->
                    <Border Style="{StaticResource WarningPanelStyle}" 
                            Visibility="{Binding IsGhostBoxAvailable, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="GhostBox DLL 未找到，请将 gbild64.dll 放入 libs/ghostbox/ 目录" 
                                       Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- 需求 6.2: 窗口捕获设置分组 -->
            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <TextBlock Text="窗口捕获设置" Style="{StaticResource SectionTitleStyle}"/>
                    <StackPanel Margin="{StaticResource SectionMargin}">
                        <TextBlock Text="目标窗口" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding WindowList}" 
                                      SelectedItem="{Binding SelectedWindow}" 
                                      DisplayMemberPath="DisplayText"
                                      IsEnabled="{Binding IsRefreshingWindows, Converter={StaticResource InvBool}}"/>
                            <ui:Button Grid.Column="1" Height="{StaticResource ButtonHeightMD}" Margin="8,0,0,0" 
                                       Command="{Binding RefreshWindowListCommand}"
                                       IsEnabled="{Binding IsRefreshingWindows, Converter={StaticResource InvBool}}"
                                       ToolTip="刷新窗口列表">
                                <ui:Button.Content>
                                    <Grid>
                                        <ui:SymbolIcon Symbol="ArrowSync20" Visibility="{Binding IsRefreshingWindows, Converter={StaticResource InvBoolToVis}}"/>
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" 
                                                         Visibility="{Binding IsRefreshingWindows, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </ui:Button.Content>
                            </ui:Button>
                        </Grid>
                        <TextBlock Text="从下拉列表选择目标窗口，点击刷新按钮更新列表" Style="{StaticResource HintTextStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch IsChecked="{Binding AppSettings.EnableWgcCapture}" Content="使用 Windows Graphics Capture" Margin="{StaticResource ItemMargin}"/>
                    <TextBlock Text="WGC性能更好，但需要Windows 10 1903+，关闭则使用BitBlt" Style="{StaticResource HintTextStyle}"/>
                </StackPanel>
            </ui:Card>

            <!-- 需求 6.2: 检测区域设置分组 -->
            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <TextBlock Text="检测区域设置" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="配置各种检测区域的屏幕坐标，点击框选按钮在屏幕上选择区域" Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource SectionMargin}"/>

                    <!-- 主检测区域 -->
                    <Grid Margin="{StaticResource SectionMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主检测区域" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MonoDisplayStyle}"
                                   Text="{Binding AppSettings.DetectionRegion, Converter={StaticResource RegionArrayToString}}"/>
                        <ui:Button Grid.Column="2" Content="框选" Height="{StaticResource ButtonHeightMD}" Margin="8,0,0,0"
                                   Command="{Binding SelectRegionCommand}" CommandParameter="Detection"/>
                        <ui:Button Grid.Column="3" Content="预览" Height="{StaticResource ButtonHeightMD}" Margin="4,0,0,0"
                                   Command="{Binding PreviewSettingsRegionCommand}" CommandParameter="Detection"/>
                    </Grid>

                    <!-- 自身血条区域 -->
                    <Grid Margin="{StaticResource SectionMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自身血条区域" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MonoDisplayStyle}"
                                   Text="{Binding AppSettings.HealthBarRegion, Converter={StaticResource RegionArrayToString}}"/>
                        <ui:Button Grid.Column="2" Content="框选" Height="{StaticResource ButtonHeightMD}" Margin="8,0,0,0"
                                   Command="{Binding SelectRegionCommand}" CommandParameter="HealthBar"/>
                        <ui:Button Grid.Column="3" Content="预览" Height="{StaticResource ButtonHeightMD}" Margin="4,0,0,0"
                                   Command="{Binding PreviewSettingsRegionCommand}" CommandParameter="HealthBar"/>
                        <ui:Button Grid.Column="4" Content="测试" Height="{StaticResource ButtonHeightMD}" Margin="4,0,0,0"
                                   Command="{Binding TestHpDetectionCommand}"/>
                    </Grid>

                    <!-- 自身蓝条区域 -->
                    <Grid Margin="{StaticResource SectionMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自身蓝条区域" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MonoDisplayStyle}"
                                   Text="{Binding AppSettings.ManaBarRegion, Converter={StaticResource RegionArrayToString}}"/>
                        <ui:Button Grid.Column="2" Content="框选" Height="{StaticResource ButtonHeightMD}" Margin="8,0,0,0"
                                   Command="{Binding SelectRegionCommand}" CommandParameter="ManaBar"/>
                        <ui:Button Grid.Column="3" Content="预览" Height="{StaticResource ButtonHeightMD}" Margin="4,0,0,0"
                                   Command="{Binding PreviewSettingsRegionCommand}" CommandParameter="ManaBar"/>
                        <ui:Button Grid.Column="4" Content="测试" Height="{StaticResource ButtonHeightMD}" Margin="4,0,0,0"
                                   Command="{Binding TestMpDetectionCommand}"/>
                    </Grid>

                    <!-- 目标血条区域 -->
                    <Grid Margin="{StaticResource SectionMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标血条区域" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MonoDisplayStyle}"
                                   Text="{Binding AppSettings.TargetHealthBarRegion, Converter={StaticResource RegionArrayToString}}"/>
                        <ui:Button Grid.Column="2" Content="框选" Height="{StaticResource ButtonHeightMD}" Margin="8,0,0,0"
                                   Command="{Binding SelectRegionCommand}" CommandParameter="TargetHealthBar"/>
                        <ui:Button Grid.Column="3" Content="预览" Height="{StaticResource ButtonHeightMD}" Margin="4,0,0,0"
                                   Command="{Binding PreviewSettingsRegionCommand}" CommandParameter="TargetHealthBar"/>
                        <ui:Button Grid.Column="4" Content="测试" Height="{StaticResource ButtonHeightMD}" Margin="4,0,0,0"
                                   Command="{Binding TestTargetHpDetectionCommand}"/>
                    </Grid>

                    <!-- 公共CD检测点 -->
                    <Grid Margin="{StaticResource ItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="公共CD检测点" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MonoDisplayStyle}"
                                       Text="{Binding AppSettings.GlobalCdPoint, Converter={StaticResource PointArrayToString}}"/>
                            <Border Background="{Binding GlobalCdPreviewColor, Converter={StaticResource ColorToBrush}}" 
                                    Width="20" Height="20" CornerRadius="3" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="选点" Height="{StaticResource ButtonHeightMD}" Margin="8,0,0,0"
                                   Command="{Binding SelectPointCommand}" CommandParameter="GlobalCd"/>
                        <ui:Button Grid.Column="3" Content="取色" Height="{StaticResource ButtonHeightMD}" Margin="4,0,0,0"
                                   Command="{Binding PickGlobalCdColorCommand}"/>
                        <ui:Button Grid.Column="4" Content="测试" Height="{StaticResource ButtonHeightMD}" Margin="4,0,0,0"
                                   Command="{Binding TestGlobalCdCommand}"/>
                    </Grid>
                    <TextBlock Text="公共CD检测点用于判断技能是否在公共冷却中" Style="{StaticResource HintTextStyle}"/>
                </StackPanel>
            </ui:Card>

            <!-- 全局快捷键设置 -->
            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionMargin}">
                        <TextBlock Text="全局快捷键" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        <ui:ToggleSwitch IsChecked="{Binding AppSettings.EnableGlobalHotkeys}" Content="启用" Margin="16,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="快捷键在游戏窗口中也能响应" Style="{StaticResource HintTextStyle}" Margin="{StaticResource SectionMargin}"/>

                    <!-- 启动/停止快捷键 -->
                    <Grid Margin="{StaticResource ItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="启动/停止" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox Width="80" SelectedIndex="{Binding StartStopModifierIndex}" Margin="0,0,8,0">
                                <ComboBoxItem Content="无"/>
                                <ComboBoxItem Content="Ctrl"/>
                                <ComboBoxItem Content="Alt"/>
                                <ComboBoxItem Content="Shift"/>
                            </ComboBox>
                            <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="{StaticResource BorderBrush}" CornerRadius="4" Padding="12,6" MinWidth="60">
                                <TextBlock Text="{Binding AppSettings.HotkeyStartStopKey, Converter={StaticResource KeyToName}}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="设置" Height="{StaticResource ButtonHeightMD}" Margin="8,0,0,0" 
                                   Command="{Binding CaptureHotkeyCommand}" CommandParameter="StartStop"/>
                    </Grid>

                    <!-- 暂停快捷键 -->
                    <Grid Margin="{StaticResource ItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="暂停/恢复" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox Width="80" SelectedIndex="{Binding PauseModifierIndex}" Margin="0,0,8,0">
                                <ComboBoxItem Content="无"/>
                                <ComboBoxItem Content="Ctrl"/>
                                <ComboBoxItem Content="Alt"/>
                                <ComboBoxItem Content="Shift"/>
                            </ComboBox>
                            <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="{StaticResource BorderBrush}" CornerRadius="4" Padding="12,6" MinWidth="60">
                                <TextBlock Text="{Binding AppSettings.HotkeyPauseKey, Converter={StaticResource KeyToName}}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="设置" Height="{StaticResource ButtonHeightMD}" Margin="8,0,0,0" 
                                   Command="{Binding CaptureHotkeyCommand}" CommandParameter="Pause"/>
                    </Grid>

                    <ui:Button Content="重新注册快捷键" Command="{Binding ReregisterHotkeysCommand}" Margin="0,8,0,0"/>
                </StackPanel>
            </ui:Card>


            <!-- 需求 5.1: GPU/CPU 切换设置 -->
            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <TextBlock Text="硬件加速设置" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="配置 ONNX 推理使用的硬件设备，DirectML 可利用 GPU 加速" Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource SectionMargin}"/>

                    <!-- 推理设备选择 -->
                    <Grid Margin="{StaticResource SectionMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="推理设备" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox SelectedIndex="{Binding InferenceDeviceIndex}" Width="200" HorizontalAlignment="Left">
                                <ComboBoxItem Content="CPU (兼容性最好)"/>
                                <ComboBoxItem Content="DirectML (GPU 加速)"/>
                            </ComboBox>
                            <TextBlock Text="DirectML 使用 Windows 通用 GPU 加速" Style="{StaticResource HintTextStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="GPU 设备 ID" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox x:Name="GpuDeviceIdTextBox"
                                        Text="{Binding AppSettings.GpuDeviceId, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewTextInput="NumericTextBox_PreviewTextInput"
                                        Width="100" HorizontalAlignment="Left"
                                        IsEnabled="{Binding IsGpuModeEnabled}"/>
                            <TextBlock Text="多 GPU 系统可指定设备，默认 0" Style="{StaticResource HintTextStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- OCR 强制 CPU -->
                    <ui:ToggleSwitch IsChecked="{Binding AppSettings.CpuOcr}" Content="OCR 强制使用 CPU" Margin="{StaticResource ItemMargin}"/>
                    <TextBlock Text="某些环境下 GPU OCR 性能较差，可强制使用 CPU" Style="{StaticResource HintTextStyle}"/>
                </StackPanel>
            </ui:Card>

            <!-- 需求 6.1, 6.2, 6.6: GhostBox 输入延迟设置 -->
            <ui:Card Margin="{StaticResource CardMargin}" Visibility="{Binding IsGhostBoxSelected, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="输入延迟设置" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="配置 GhostBox 输入的随机延迟，使操作更像人类" Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource SectionMargin}"/>

                    <!-- 启用随机延迟 -->
                    <ui:ToggleSwitch IsChecked="{Binding AppSettings.EnableRandomDelay}" Content="启用随机延迟" Margin="{StaticResource ItemMargin}"/>

                    <!-- 按键延迟范围 -->
                    <Grid Margin="{StaticResource SectionMargin}" IsEnabled="{Binding AppSettings.EnableRandomDelay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="按键最小延迟 (毫秒)" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox x:Name="KeyPressMinDelayTextBox"
                                        Text="{Binding AppSettings.KeyPressMinDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewTextInput="NumericTextBox_PreviewTextInput"
                                        LostFocus="KeyPressMinDelayTextBox_LostFocus"/>
                            <TextBlock Text="按键按下后的最小等待时间" Style="{StaticResource HintTextStyle}"/>
                            <TextBlock x:Name="KeyPressMinDelayError" Style="{StaticResource ValidationErrorStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="按键最大延迟 (毫秒)" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox x:Name="KeyPressMaxDelayTextBox"
                                        Text="{Binding AppSettings.KeyPressMaxDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewTextInput="NumericTextBox_PreviewTextInput"
                                        LostFocus="KeyPressMaxDelayTextBox_LostFocus"/>
                            <TextBlock Text="按键按下后的最大等待时间" Style="{StaticResource HintTextStyle}"/>
                            <TextBlock x:Name="KeyPressMaxDelayError" Style="{StaticResource ValidationErrorStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 最小按键间隔 -->
                    <StackPanel Margin="{StaticResource SectionMargin}">
                        <TextBlock Text="最小按键间隔 (毫秒)" Style="{StaticResource FieldLabelStyle}"/>
                        <ui:TextBox x:Name="MinInterKeyDelayTextBox"
                                    Text="{Binding AppSettings.MinInterKeyDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewTextInput="NumericTextBox_PreviewTextInput"
                                    LostFocus="MinInterKeyDelayTextBox_LostFocus"
                                    Width="150" HorizontalAlignment="Left"/>
                        <TextBlock Text="连续按键之间的最小间隔，防止按键过快" Style="{StaticResource HintTextStyle}"/>
                        <TextBlock x:Name="MinInterKeyDelayError" Style="{StaticResource ValidationErrorStyle}"/>
                    </StackPanel>

                    <!-- 贝塞尔曲线鼠标移动 -->
                    <ui:ToggleSwitch IsChecked="{Binding AppSettings.UseBezierMouseMove}" Content="使用贝塞尔曲线鼠标移动" Margin="{StaticResource ItemMargin}"/>
                    <TextBlock Text="模拟人类鼠标移动轨迹，使移动更自然" Style="{StaticResource HintTextStyle}"/>

                    <!-- 贝塞尔曲线步数 -->
                    <StackPanel Margin="{StaticResource SectionMargin}" IsEnabled="{Binding AppSettings.UseBezierMouseMove}">
                        <TextBlock Text="鼠标移动路径点数" Style="{StaticResource FieldLabelStyle}"/>
                        <ui:TextBox x:Name="BezierMouseStepsTextBox"
                                    Text="{Binding AppSettings.BezierMouseSteps, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewTextInput="NumericTextBox_PreviewTextInput"
                                    LostFocus="BezierMouseStepsTextBox_LostFocus"
                                    Width="150" HorizontalAlignment="Left"/>
                        <TextBlock Text="路径点越多移动越平滑，建议 10-50" Style="{StaticResource HintTextStyle}"/>
                        <TextBlock x:Name="BezierMouseStepsError" Style="{StaticResource ValidationErrorStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 需求 6.4, 6.5: GhostBox 重连设置 -->
            <ui:Card Margin="{StaticResource CardMargin}" Visibility="{Binding IsGhostBoxSelected, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="自动重连设置" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="配置 GhostBox 设备断开后的自动重连行为" Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource SectionMargin}"/>

                    <!-- 启用自动重连 -->
                    <ui:ToggleSwitch IsChecked="{Binding AppSettings.EnableAutoReconnect}" Content="启用自动重连" Margin="{StaticResource ItemMargin}"/>

                    <!-- 重连参数 -->
                    <Grid Margin="{StaticResource SectionMargin}" IsEnabled="{Binding AppSettings.EnableAutoReconnect}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="重连间隔 (毫秒)" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox x:Name="ReconnectRetryIntervalTextBox"
                                        Text="{Binding AppSettings.ReconnectRetryIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewTextInput="NumericTextBox_PreviewTextInput"
                                        LostFocus="ReconnectRetryIntervalTextBox_LostFocus"/>
                            <TextBlock Text="每次重连尝试之间的等待时间" Style="{StaticResource HintTextStyle}"/>
                            <TextBlock x:Name="ReconnectRetryIntervalError" Style="{StaticResource ValidationErrorStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="最大重试次数" Style="{StaticResource FieldLabelStyle}"/>
                            <ui:TextBox x:Name="ReconnectMaxRetriesTextBox"
                                        Text="{Binding AppSettings.ReconnectMaxRetries, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewTextInput="NumericTextBox_PreviewTextInput"
                                        LostFocus="ReconnectMaxRetriesTextBox_LostFocus"/>
                            <TextBlock Text="0 表示无限重试" Style="{StaticResource HintTextStyle}"/>
                            <TextBlock x:Name="ReconnectMaxRetriesError" Style="{StaticResource ValidationErrorStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 需求 6.5: 配置导入导出 -->
            <!-- 需求 13.5: 使用 SymbolIcon 作为按钮图标 -->
            <ui:Card Margin="{StaticResource CardMargin}">
                <StackPanel>
                    <TextBlock Text="配置导入导出" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="导出配置可用于备份或分享给其他用户" Style="{StaticResource HintTextStyle}" Margin="{StaticResource SectionMargin}"/>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="导出全部配置" Command="{Binding ExportConfigCommand}" Margin="0,0,8,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowUpload24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="导入配置" Command="{Binding ImportConfigCommand}" Margin="0,0,8,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="导出当前方案" Command="{Binding ExportProfileCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 保存按钮 -->
            <ui:Button Content="保存设置" Appearance="Primary" Command="{Binding SaveSettingsCommand}" 
                       Height="{StaticResource ButtonHeightXL}" HorizontalAlignment="Stretch"/>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
