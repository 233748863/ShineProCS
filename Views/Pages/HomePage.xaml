<Page x:Class="ShineProCS.Views.Pages.HomePage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:utils="clr-namespace:ShineProCS.Utils"
         Title="启动"
         ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
         ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
         Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    
    <!-- 
    需求 3: 启动页显示引擎状态和快速控制按钮
    需求 13.3, 13.4, 13.5: 统一间距、Card组件和SymbolIcon使用
    -->
    
    <Page.Resources>
        <utils:InverseBooleanConverter x:Key="InvBool"/>
        <utils:LogTextColorConverter x:Key="LogColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </Page.Resources>
    
    <!-- 需求 13.3: 使用统一的页面边距 -->
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 需求 3.1, 3.3: 引擎运行指标 -->
        <!-- 需求 13.4: 使用 Card 组件分组 -->
        <ui:Card Grid.Column="0" Grid.Row="0" Margin="{StaticResource CardMargin}">
            <StackPanel>
                <TextBlock Text="引擎运行指标" Style="{StaticResource CardTitleStyle}"/>
                <UniformGrid Columns="4">
                    <StackPanel>
                        <TextBlock Text="状态" Style="{StaticResource HintTextStyle}" Margin="0"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="20" 
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="执行次数" Style="{StaticResource HintTextStyle}" Margin="0"/>
                        <TextBlock Text="{Binding ExecutionCount}" FontWeight="Bold" FontSize="20"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="平均响应" Style="{StaticResource HintTextStyle}" Margin="0"/>
                        <TextBlock Text="{Binding AvgResponseTime, StringFormat={}{0:F1}ms}" FontWeight="Bold" FontSize="20"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="成功率" Style="{StaticResource HintTextStyle}" Margin="0"/>
                        <TextBlock Text="{Binding SuccessRate, StringFormat={}{0:F1}%}" FontWeight="Bold" FontSize="20" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="{Binding MemoryStats}" Style="{StaticResource HintTextStyle}" Margin="0,8,0,0"/>
            </StackPanel>
        </ui:Card>

        <!-- 技能状态面板 -->
        <ui:Card Grid.Column="0" Grid.Row="1" Margin="0,0,16,12">
            <StackPanel>
                <TextBlock Text="技能实时状态" Style="{StaticResource CardTitleStyle}"/>
                <ItemsControl ItemsSource="{Binding SkillStatusList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,8" Padding="10,6" CornerRadius="6" MinWidth="100">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                <Setter Property="Background" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Cooldown">
                                                <Setter Property="Background" Value="#F57C00"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="NoBuff">
                                                <Setter Property="Background" Value="#C62828"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                <Setter Property="Background" Value="{StaticResource TextDisabledBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StatusIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#CCC"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>

        <!-- 需求 3.4: 运行日志面板 -->
        <ui:Card Grid.Column="0" Grid.Row="2" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="运行日志" Style="{StaticResource CardTitleStyle}" Margin="0"/>
                    <ui:Button Content="清空" Command="{Binding ClearLogsCommand}" HorizontalAlignment="Right" Appearance="Secondary"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding LogMessages}" Background="Transparent" BorderThickness="0" 
                         FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource FontSizeMD}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{Binding Converter={StaticResource LogColorConverter}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </ui:Card>

        <!-- 需求 3.2: 控制中心 - 启动、暂停、停止按钮 -->
        <!-- 需求 13.4: 使用 Card 组件分组 -->
        <!-- 需求 13.5: 使用 SymbolIcon 作为按钮图标 -->
        <ui:Card Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="控制中心" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10"/>
                
                <!-- 需求 3.6: 截图方式选择器 -->
                <TextBlock Text="截图方式" Style="{StaticResource HintTextStyle}" Margin="0,0,0,4"/>
                <ComboBox SelectedIndex="{Binding CaptureModeIndex}" Margin="{StaticResource SectionMargin}">
                    <ComboBoxItem Content="Windows Graphics Capture (WGC)"/>
                    <ComboBoxItem Content="BitBlt"/>
                </ComboBox>
                
                <ui:Button Command="{Binding StartEngineCommand}" Appearance="Primary" Height="{StaticResource ButtonHeightLG}" Margin="{StaticResource SmallMargin}" 
                           HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}" 
                           Icon="{ui:SymbolIcon Play24}">
                    <ui:Button.Content>
                        <TextBlock Text="启动引擎" Margin="4,0,0,0"/>
                    </ui:Button.Content>
                </ui:Button>
                <ui:Button Command="{Binding PauseEngineCommand}" Height="{StaticResource ButtonHeightLG}" Margin="{StaticResource SmallMargin}" 
                           HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning}" 
                           Icon="{ui:SymbolIcon Pause24}">
                    <ui:Button.Content>
                        <TextBlock Text="暂停/恢复" Margin="4,0,0,0"/>
                    </ui:Button.Content>
                </ui:Button>
                <ui:Button Command="{Binding StopEngineCommand}" Height="{StaticResource ButtonHeightLG}" Margin="{StaticResource SmallMargin}" 
                           HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning}" 
                           Icon="{ui:SymbolIcon Stop24}">
                    <ui:Button.Content>
                        <TextBlock Text="停止引擎" Margin="4,0,0,0"/>
                    </ui:Button.Content>
                </ui:Button>
                
                <Separator Margin="0,8"/>
                
                <ui:Button Command="{Binding ToggleOverlayCommand}" Height="30" Margin="{StaticResource SmallMargin}" 
                           HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon WindowNew20}">
                    <ui:Button.Content>
                        <TextBlock Text="切换悬浮窗" Margin="4,0,0,0"/>
                    </ui:Button.Content>
                </ui:Button>
                <ui:Button Command="{Binding ReloadConfigCommand}" Height="30" Margin="{StaticResource SmallMargin}" 
                           HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowSync20}">
                    <ui:Button.Content>
                        <TextBlock Text="重新加载配置" Margin="4,0,0,0"/>
                    </ui:Button.Content>
                </ui:Button>
                <ui:Button Command="{Binding ForceCleanupCommand}" Height="30" Margin="{StaticResource SmallMargin}" 
                           HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Delete20}">
                    <ui:Button.Content>
                        <TextBlock Text="清理内存" Margin="4,0,0,0"/>
                    </ui:Button.Content>
                </ui:Button>
                
                <Separator Margin="0,8"/>
                
                <!-- 需求 19.1, 20.1: 独立任务入口 -->
                <TextBlock Text="独立任务" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                
                <ui:Button Command="{Binding StartAutoDomainCommand}" Height="30" Margin="{StaticResource SmallMargin}" 
                           HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Games24}"
                           IsEnabled="{Binding IsAutoDomainRunning, Converter={StaticResource InvBool}}"
                           Visibility="{Binding AppSettings.EnableAutoDomain, Converter={StaticResource BoolToVis}}">
                    <ui:Button.Content>
                        <TextBlock Text="自动秘境" Margin="4,0,0,0"/>
                    </ui:Button.Content>
                </ui:Button>
                
                <ui:Button Command="{Binding StartPathingCommand}" Height="30" Margin="{StaticResource SmallMargin}" 
                           HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Map24}"
                           IsEnabled="{Binding IsPathingRunning, Converter={StaticResource InvBool}}">
                    <ui:Button.Content>
                        <TextBlock Text="地图追踪" Margin="4,0,0,0"/>
                    </ui:Button.Content>
                </ui:Button>
                
                <ui:Button Command="{Binding StopSoloTaskCommand}" Height="30" Margin="{StaticResource SmallMargin}" 
                           HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Secondary"
                           Visibility="{Binding IsSoloTaskRunning, Converter={StaticResource BoolToVis}}">
                    <ui:Button.Content>
                        <TextBlock Text="停止任务" Margin="4,0,0,0"/>
                    </ui:Button.Content>
                </ui:Button>
                
                <Separator Margin="0,8"/>
                
                <!-- 需求 21.1: 遮罩窗口控制 -->
                <TextBlock Text="遮罩窗口" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                
                <ui:ToggleSwitch IsChecked="{Binding AppSettings.EnableMaskWindow}" Content="启用遮罩窗口" Margin="0,0,0,4"/>
                
                <StackPanel Visibility="{Binding AppSettings.EnableMaskWindow, Converter={StaticResource BoolToVis}}">
                    <ui:Button Command="{Binding ToggleMaskWindowCommand}" Height="30" Margin="{StaticResource SmallMargin}" 
                               HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon WindowDevTools20}">
                        <ui:Button.Content>
                            <TextBlock Text="{Binding MaskWindowButtonText}" Margin="4,0,0,0"/>
                        </ui:Button.Content>
                    </ui:Button>
                    
                    <Expander Header="遮罩窗口设置" Margin="0,4,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <ui:ToggleSwitch IsChecked="{Binding AppSettings.MaskShowLogBox}" Content="显示日志框" Margin="0,0,0,4"/>
                            <ui:ToggleSwitch IsChecked="{Binding AppSettings.MaskShowStatus}" Content="显示状态指示" Margin="0,0,0,4"/>
                            <ui:ToggleSwitch IsChecked="{Binding AppSettings.MaskDisplayRecognitionResults}" Content="显示识别结果" Margin="0,0,0,4"/>
                            <ui:ToggleSwitch IsChecked="{Binding AppSettings.MaskShowFps}" Content="显示 FPS" Margin="0,0,0,4"/>
                            <ui:ToggleSwitch IsChecked="{Binding AppSettings.MaskUseSubform}" Content="作为游戏子窗体" Margin="0,0,0,4"/>
                            
                            <TextBlock Text="文本透明度" Style="{StaticResource HintTextStyle}" Margin="0,4,0,2"/>
                            <Slider Minimum="0.1" Maximum="1.0" Value="{Binding AppSettings.MaskTextOpacity}" 
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                
                <Separator Margin="0,8"/>
                
                <!-- 快捷键提示 -->
                <TextBlock Text="快捷键" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                <TextBlock Text="Ctrl+F7 启动/停止" FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource TextTertiaryBrush}"/>
                <TextBlock Text="Ctrl+F8 暂停/恢复" FontSize="{StaticResource FontSizeXS}" Foreground="{StaticResource TextTertiaryBrush}"/>
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
