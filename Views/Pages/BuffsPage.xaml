<Page x:Class="ShineProCS.Views.Pages.BuffsPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:local="clr-namespace:ShineProCS.Views"
         Title="Buff库"
         ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
         ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
         Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    
    <!-- 
    需求 5: Buff库页面
    需求 13.3: 使用统一的页面边距
    
    注意：使用 VerticalAlignment="Stretch" 确保内容填充整个可用高度
    -->
    
    <Grid Margin="{StaticResource PageMargin}" VerticalAlignment="Stretch">
        <local:BuffLibraryPage x:Name="BuffLibraryPageControl" VerticalAlignment="Stretch"/>
    </Grid>
</Page>
