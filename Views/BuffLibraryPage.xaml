<UserControl x:Class="ShineProCS.Views.BuffLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    
    <!-- 
    需求 5: Buff库页面
    需求 13.3, 13.4, 13.5: 统一间距、Card组件和SymbolIcon使用
    -->
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧：Buff列表 -->
        <!-- 需求 13.4: 使用 Card 组件分组 -->
        <ui:Card Grid.Column="0" Margin="0,0,12,0">
            <DockPanel>
                <!-- 标题栏 -->
                <DockPanel DockPanel.Dock="Top" Margin="{StaticResource SectionMargin}">
                    <TextBlock Text="Buff/Debuff 库" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="AddBuffButton" Content="+ 添加" Appearance="Primary" Height="{StaticResource ButtonHeightMD}" Click="AddBuff_Click"/>
                    </StackPanel>
                </DockPanel>
                
                <TextBlock DockPanel.Dock="Top" Text="统一管理所有Buff/Debuff的检测配置，技能可以引用这些配置" 
                           Style="{StaticResource SecondaryTextStyle}" Margin="{StaticResource SectionMargin}"/>
                
                <!-- 搜索和筛选栏 - 需求 5.1, 5.3 -->
                <Grid DockPanel.Dock="Top" Margin="{StaticResource SectionMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 搜索框 -->
                    <ui:TextBox x:Name="SearchBox" 
                                PlaceholderText="搜索 Buff 名称..." 
                                TextChanged="SearchBox_TextChanged"
                                Margin="0,0,8,0"/>
                    
                    <!-- 类别筛选 -->
                    <ComboBox x:Name="CategoryFilter" 
                              Grid.Column="1" 
                              Width="100" 
                              Margin="0,0,8,0"
                              SelectionChanged="CategoryFilter_SelectionChanged">
                        <ComboBoxItem Content="全部" IsSelected="True" Tag="All"/>
                        <ComboBoxItem Content="Buff" Tag="Buff"/>
                        <ComboBoxItem Content="Debuff" Tag="Debuff"/>
                    </ComboBox>
                    
                    <!-- 状态筛选 -->
                    <ComboBox x:Name="StatusFilter" 
                              Grid.Column="2" 
                              Width="100"
                              SelectionChanged="StatusFilter_SelectionChanged">
                        <ComboBoxItem Content="全部状态" IsSelected="True" Tag="All"/>
                        <ComboBoxItem Content="已启用" Tag="Enabled"/>
                        <ComboBoxItem Content="已禁用" Tag="Disabled"/>
                        <ComboBoxItem Content="已配置" Tag="Configured"/>
                        <ComboBoxItem Content="未配置" Tag="NotConfigured"/>
                    </ComboBox>
                </Grid>
                
                <!-- 筛选结果统计 -->
                <TextBlock x:Name="FilterResultText" DockPanel.Dock="Top" 
                           Text="共 0 个 Buff" 
                           FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextTertiaryBrush}" Margin="{StaticResource ItemMargin}"/>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="BuffList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="BuffList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListItemContainerStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- 类型图标 -->
                                        <Border Width="36" Height="36" CornerRadius="4" Margin="0,0,12,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDebuff}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="{StaticResource FontSizeXL}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDebuff}" Value="True">
                                                                <Setter Property="Text" Value="D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        
                                        <!-- 名称和状态 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeLG}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding ConfigStatus}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                <!-- 引用计数显示 - 需求 5.4 -->
                                                <TextBlock x:Name="RefCountText" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextTertiaryBrush}" Margin="8,0,0,0"
                                                           Text="{Binding ReferenceCount, StringFormat='· 被引用 {0} 次'}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- 引用计数徽章 -->
                                        <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}" Margin="8,0"
                                                Visibility="{Binding HasReferences, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ReferenceCount}" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                        
                                        <!-- 启用开关 -->
                                        <CheckBox Grid.Column="3" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="8,0"
                                                  Checked="BuffEnabled_Changed" Unchecked="BuffEnabled_Changed"/>
                                        
                                        <!-- 删除按钮 -->
                                        <ui:Button Grid.Column="4" Content="×" Width="28" Height="28" Padding="0" 
                                                   Tag="{Binding}" Click="DeleteBuff_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </ui:Card>
        
        <!-- 右侧：编辑面板 -->
        <ui:Card Grid.Column="1">
            <Grid>
                <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                    <TextBlock Text="编辑 Buff" Style="{StaticResource SectionTitleStyle}"/>
                    
                    <!-- 基础信息 -->
                    <TextBlock Text="名称标识" Style="{StaticResource HintTextStyle}" Margin="{StaticResource SmallMargin}"/>
                    <ui:TextBox x:Name="BuffNameBox" Margin="{StaticResource SectionMargin}"/>
                    
                    <TextBlock Text="显示名称" Style="{StaticResource HintTextStyle}" Margin="{StaticResource SmallMargin}"/>
                    <ui:TextBox x:Name="BuffDisplayNameBox" Margin="{StaticResource SectionMargin}"/>
                    
                    <TextBlock Text="备注说明" Style="{StaticResource HintTextStyle}" Margin="{StaticResource SmallMargin}"/>
                    <ui:TextBox x:Name="BuffDescriptionBox" Margin="{StaticResource SectionMargin}"/>
                    
                    <CheckBox x:Name="IsDebuffCheck" Content="这是一个Debuff（负面效果）" Margin="{StaticResource CardMargin}"/>
                    
                    <!-- 检测配置 -->
                    <TextBlock Text="检测区域" Style="{StaticResource HintTextStyle}" Margin="{StaticResource SmallMargin}"/>
                    <Grid Margin="{StaticResource ItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <UniformGrid Columns="4">
                            <ui:TextBox x:Name="RegionX" PlaceholderText="X" Margin="0,0,4,0"/>
                            <ui:TextBox x:Name="RegionY" PlaceholderText="Y" Margin="2,0"/>
                            <ui:TextBox x:Name="RegionW" PlaceholderText="宽" Margin="2,0"/>
                            <ui:TextBox x:Name="RegionH" PlaceholderText="高" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <ui:Button Grid.Column="1" Content="框选" Height="{StaticResource ButtonHeightMD}" Margin="8,0,0,0" Click="SelectRegion_Click"/>
                    </Grid>
                    
                    <TextBlock Text="模板图片" Style="{StaticResource HintTextStyle}" Margin="{StaticResource SmallMargin}"/>
                    <Grid Margin="{StaticResource ItemMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TemplatePathBox" IsReadOnly="True"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <ui:Button Content="截取" Height="{StaticResource ButtonHeightMD}" Click="CaptureTemplate_Click"/>
                            <ui:Button Content="测试" Height="{StaticResource ButtonHeightMD}" Margin="4,0,0,0" Appearance="Info" Click="TestMatch_Click"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- 模板预览 -->
                    <Border x:Name="TemplatePreviewBorder" Style="{StaticResource InfoPanelStyle}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="TemplatePreviewImage" Width="48" Height="48" Stretch="Uniform"/>
                            <TextBlock x:Name="TemplateInfoText" Text="模板信息" FontSize="{StaticResource FontSizeMD}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Text="匹配阈值" Style="{StaticResource HintTextStyle}" Margin="{StaticResource SmallMargin}"/>
                    <ui:TextBox x:Name="ThresholdBox" Text="0.8" Margin="{StaticResource CardMargin}"/>
                    
                    <!-- 引用信息显示 -->
                    <Border x:Name="ReferenceInfoPanel" Style="{StaticResource InfoPanelStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="被以下技能引用：" Style="{StaticResource HintTextStyle}" Margin="{StaticResource SmallMargin}"/>
                            <TextBlock x:Name="ReferenceSkillsText" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 保存按钮 -->
                    <ui:Button Content="保存修改" Appearance="Primary" Height="{StaticResource ButtonHeightLG}" HorizontalAlignment="Stretch" Click="SaveBuff_Click"/>
                </StackPanel>
                
                <!-- 空状态提示 -->
                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="[Buff]" FontSize="32" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="选择一个Buff进行编辑" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="或点击 添加 创建新的Buff" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" FontSize="{StaticResource FontSizeMD}"/>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
