<UserControl x:Class="ShineProCS.Views.BuffLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧：Buff列表 -->
        <ui:Card Grid.Column="0" Margin="0,0,12,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Buff/Debuff 库" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="+ 添加" Appearance="Primary" Height="32" Click="AddBuff_Click"/>
                    </StackPanel>
                </DockPanel>
                
                <TextBlock DockPanel.Dock="Top" Text="统一管理所有Buff/Debuff的检测配置，技能可以引用这些配置" 
                           Foreground="#888" FontSize="12" Margin="0,0,0,12"/>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="BuffList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="BuffList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252525" CornerRadius="6" Margin="0,0,0,8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- 类型图标 -->
                                        <Border Width="36" Height="36" CornerRadius="4" Margin="0,0,12,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2E7D32"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDebuff}" Value="True">
                                                            <Setter Property="Background" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDebuff}" Value="True">
                                                                <Setter Property="Text" Value="D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        
                                        <!-- 名称和状态 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding ConfigStatus}" FontSize="11" Foreground="#888" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- 启用开关 -->
                                        <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="8,0"/>
                                        
                                        <!-- 删除按钮 -->
                                        <ui:Button Grid.Column="3" Content="x" Width="28" Height="28" Padding="0" 
                                                   Tag="{Binding}" Click="DeleteBuff_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </ui:Card>
        
        <!-- 右侧：编辑面板 -->
        <ui:Card Grid.Column="1">
            <Grid>
                <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                    <TextBlock Text="编辑 Buff" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <!-- 基础信息 -->
                    <TextBlock Text="名称标识" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="BuffNameBox" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="显示名称" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="BuffDisplayNameBox" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="备注说明" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="BuffDescriptionBox" Margin="0,0,0,12"/>
                    
                    <CheckBox x:Name="IsDebuffCheck" Content="这是一个Debuff（负面效果）" Margin="0,0,0,16"/>
                    
                    <!-- 检测配置 -->
                    <TextBlock Text="检测区域" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <UniformGrid Columns="4">
                            <ui:TextBox x:Name="RegionX" PlaceholderText="X" Margin="0,0,4,0"/>
                            <ui:TextBox x:Name="RegionY" PlaceholderText="Y" Margin="2,0"/>
                            <ui:TextBox x:Name="RegionW" PlaceholderText="宽" Margin="2,0"/>
                            <ui:TextBox x:Name="RegionH" PlaceholderText="高" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <ui:Button Grid.Column="1" Content="框选" Height="32" Margin="8,0,0,0" Click="SelectRegion_Click"/>
                    </Grid>
                    
                    <TextBlock Text="模板图片" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TemplatePathBox" IsReadOnly="True"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <ui:Button Content="截取" Height="32" Click="CaptureTemplate_Click"/>
                            <ui:Button Content="测试" Height="32" Margin="4,0,0,0" Appearance="Info" Click="TestMatch_Click"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- 模板预览 -->
                    <Border x:Name="TemplatePreviewBorder" Background="#1a1a1a" CornerRadius="4" Padding="8" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="TemplatePreviewImage" Width="48" Height="48" Stretch="Uniform"/>
                            <TextBlock x:Name="TemplateInfoText" Text="模板信息" FontSize="12" Foreground="#CCC" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Text="匹配阈值" FontSize="12" Foreground="#999" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="ThresholdBox" Text="0.8" Margin="0,0,0,16"/>
                    
                    <!-- 保存按钮 -->
                    <ui:Button Content="保存修改" Appearance="Primary" Height="36" HorizontalAlignment="Stretch" Click="SaveBuff_Click"/>
                </StackPanel>
                
                <!-- 空状态提示 -->
                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="[Buff]" FontSize="32" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="选择一个Buff进行编辑" Foreground="#666" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="或点击 添加 创建新的Buff" Foreground="#666" HorizontalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
