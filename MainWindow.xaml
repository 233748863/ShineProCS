<ui:FluentWindow x:Class="ShineProCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ShineProCS.ViewModels"
        xmlns:utils="clr-namespace:ShineProCS.Utils"
        xmlns:local="clr-namespace:ShineProCS.Views"
        x:Name="RootWindow"
        Title="ShineProCS - 游戏自动化引擎" Height="750" Width="1150"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <Window.Resources>
        <utils:InverseBooleanConverter x:Key="InvBool"/>
        <utils:KeyCodeToNameConverter x:Key="KeyToName"/>
        <utils:LogTextColorConverter x:Key="LogColorConverter"/>
        <utils:BoolToAddRemoveConverter x:Key="BoolToAddRemove"/>
        <utils:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="4,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <ui:TitleBar Title="ShineProCS - 游戏自动化引擎" Grid.Row="0"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧导航栏 -->
            <Border Background="#1a1a1a" Grid.Column="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
                        <TextBlock Text="快捷键" FontWeight="SemiBold" FontSize="11" Foreground="#999"/>
                        <TextBlock Text="Ctrl+F7 启动/停止" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="Ctrl+F8 暂停/恢复" FontSize="10" Foreground="#888"/>
                    </StackPanel>
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" SelectedIndex="0" ItemContainerStyle="{StaticResource NavItemStyle}">
                        <ListBoxItem Tag="status">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Target24" Margin="0,0,12,0"/>
                                <TextBlock Text="运行监控" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="skills">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Star24" Margin="0,0,12,0"/>
                                <TextBlock Text="技能配置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="buffs">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Shield24" Margin="0,0,12,0"/>
                                <TextBlock Text="Buff库" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0"/>
                                <TextBlock Text="全局设置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>
            
            <!-- 右侧内容区 -->
            <Grid Grid.Column="1" Margin="16">
                <!-- 运行监控页 -->
                <Grid x:Name="StatusPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=NavList, Path=SelectedItem.Tag}" Value="status"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <!-- 引擎运行指标 -->
                    <ui:Card Grid.Column="0" Grid.Row="0" Margin="0,0,16,12">
                        <StackPanel>
                            <TextBlock Text="引擎运行指标" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <UniformGrid Columns="4">
                                <StackPanel><TextBlock Text="状态" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></StackPanel>
                                <StackPanel><TextBlock Text="执行次数" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding ExecutionCount}" FontWeight="Bold" FontSize="20"/></StackPanel>
                                <StackPanel><TextBlock Text="平均响应" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding AvgResponseTime, StringFormat={}{0:F1}ms}" FontWeight="Bold" FontSize="20"/></StackPanel>
                                <StackPanel><TextBlock Text="成功率" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding SuccessRate, StringFormat={}{0:F1}%}" FontWeight="Bold" FontSize="20" Foreground="#4CAF50"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding MemoryStats}" Foreground="#999" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- 技能状态面板 -->
                    <ui:Card Grid.Column="0" Grid.Row="1" Margin="0,0,16,12">
                        <StackPanel>
                            <TextBlock Text="技能实时状态" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding SkillStatusList}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,8,8" Padding="10,6" CornerRadius="6" MinWidth="100">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#333"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter Property="Background" Value="#2E7D32"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cooldown"><Setter Property="Background" Value="#F57C00"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NoBuff"><Setter Property="Background" Value="#C62828"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled"><Setter Property="Background" Value="#424242"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#CCC"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>

                    <!-- 运行日志 -->
                    <ui:Card Grid.Column="0" Grid.Row="2" Margin="0,0,16,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold"/>
                                <ui:Button Content="清空" Command="{Binding ClearLogsCommand}" HorizontalAlignment="Right" Appearance="Secondary"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding LogMessages}" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Converter={StaticResource LogColorConverter}}"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </ui:Card>

                    <!-- 控制中心 -->
                    <ui:Card Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="控制中心" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ui:Button Command="{Binding StartEngineCommand}" Appearance="Primary" Height="38" Margin="0,0,0,4" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}" Icon="{ui:SymbolIcon Play24}">
                                <ui:Button.Content><TextBlock Text="启动引擎" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <ui:Button Command="{Binding PauseEngineCommand}" Height="38" Margin="0,0,0,4" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning}" Icon="{ui:SymbolIcon Pause24}">
                                <ui:Button.Content><TextBlock Text="暂停/恢复" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <ui:Button Command="{Binding StopEngineCommand}" Height="38" Margin="0,0,0,4" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning}" Icon="{ui:SymbolIcon Stop24}">
                                <ui:Button.Content><TextBlock Text="停止引擎" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <Separator Margin="0,8"/>
                            <ui:Button Command="{Binding ToggleOverlayCommand}" Height="30" Margin="0,0,0,4" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon WindowNew20}">
                                <ui:Button.Content><TextBlock Text="切换悬浮窗" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <ui:Button Command="{Binding ReloadConfigCommand}" Height="30" Margin="0,0,0,4" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowSync20}">
                                <ui:Button.Content><TextBlock Text="重新加载配置" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <ui:Button Command="{Binding ForceCleanupCommand}" Height="30" Margin="0,0,0,4" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Delete20}">
                                <ui:Button.Content><TextBlock Text="清理内存" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <Separator Margin="0,4"/>
                            <TextBlock Text="配置管理" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <ui:Button Command="{Binding ExportConfigCommand}" Height="28" Margin="0,0,0,4" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowExportUp20}">
                                <ui:Button.Content><TextBlock Text="导出配置" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <ui:Button Command="{Binding ImportConfigCommand}" Height="28" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowImport20}">
                                <ui:Button.Content><TextBlock Text="导入配置" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- 技能配置页（卡片式布局） -->
                <Grid x:Name="SkillsPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=NavList, Path=SelectedItem.Tag}" Value="skills"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <local:SkillConfigPage x:Name="SkillConfigPageControl"/>
                </Grid>

                <!-- Buff库页面 -->
                <Grid x:Name="BuffsPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=NavList, Path=SelectedItem.Tag}" Value="buffs"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <local:BuffLibraryPage x:Name="BuffLibraryPageControl"/>
                </Grid>

                <!-- 全局设置页 -->
                <Grid x:Name="SettingsPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=NavList, Path=SelectedItem.Tag}" Value="settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel MaxWidth="700">
                            <TextBlock Text="全局设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
                            
                            <!-- 引擎设置 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="引擎设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="循环间隔 (毫秒)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Settings.LoopInterval}"/>
                                            <TextBlock Text="主循环检测间隔，建议50-200ms" Style="{StaticResource HintTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="按键间隔 (毫秒)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Settings.KeyPressInterval}"/>
                                            <TextBlock Text="连续按键之间的间隔" Style="{StaticResource HintTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="模板匹配阈值" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Settings.MatchThreshold}"/>
                                            <TextBlock Text="0.0-1.0，越高越严格，建议0.8" Style="{StaticResource HintTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="GC间隔 (秒)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Settings.GCIntervalSeconds}"/>
                                            <TextBlock Text="内存清理间隔，0=禁用" Style="{StaticResource HintTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 窗口捕获设置 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="窗口捕获设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="目标窗口标题" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding Settings.TargetWindowTitle}"/>
                                        <TextBlock Text="游戏窗口标题，支持部分匹配" Style="{StaticResource HintTextStyle}"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch IsChecked="{Binding Settings.UseWGC}" Content="使用 Windows Graphics Capture" Margin="0,0,0,8"/>
                                    <TextBlock Text="WGC性能更好，但需要Windows 10 1903+，关闭则使用BitBlt" Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- HP/MP检测区域 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="自身 HP/MP 检测区域" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="自身HP条区域 (X, Y, 宽, 高)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="4">
                                                <ui:TextBox Text="{Binding AppSettings.HealthBarRegion[0]}" PlaceholderText="X" Margin="0,0,4,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.HealthBarRegion[1]}" PlaceholderText="Y" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.HealthBarRegion[2]}" PlaceholderText="宽" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.HealthBarRegion[3]}" PlaceholderText="高" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="框选" Height="32" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding SelectRegionCommand}" CommandParameter="HealthBar"/>
                                        <ui:Button Grid.Column="2" Content="测试" Height="32" Margin="4,0,0,0" VerticalAlignment="Bottom" Appearance="Info" Command="{Binding TestHpDetectionCommand}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="自身MP条区域 (X, Y, 宽, 高)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="4">
                                                <ui:TextBox Text="{Binding AppSettings.ManaBarRegion[0]}" PlaceholderText="X" Margin="0,0,4,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.ManaBarRegion[1]}" PlaceholderText="Y" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.ManaBarRegion[2]}" PlaceholderText="宽" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.ManaBarRegion[3]}" PlaceholderText="高" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="框选" Height="32" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding SelectRegionCommand}" CommandParameter="ManaBar"/>
                                        <ui:Button Grid.Column="2" Content="测试" Height="32" Margin="4,0,0,0" VerticalAlignment="Bottom" Appearance="Info" Command="{Binding TestMpDetectionCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 目标HP检测区域 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="目标 HP 检测区域" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="用于治疗/辅助技能，检测目标（队友）的血量" Foreground="#888" FontSize="12" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="目标HP条区域 (X, Y, 宽, 高)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="4">
                                                <ui:TextBox Text="{Binding AppSettings.TargetHealthBarRegion[0]}" PlaceholderText="X" Margin="0,0,4,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.TargetHealthBarRegion[1]}" PlaceholderText="Y" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.TargetHealthBarRegion[2]}" PlaceholderText="宽" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.TargetHealthBarRegion[3]}" PlaceholderText="高" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="框选" Height="32" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding SelectRegionCommand}" CommandParameter="TargetHealthBar"/>
                                        <ui:Button Grid.Column="2" Content="测试" Height="32" Margin="4,0,0,0" VerticalAlignment="Bottom" Appearance="Info" Command="{Binding TestTargetHpDetectionCommand}"/>
                                    </Grid>
                                    <TextBlock Text="💡 Buff/Debuff检测请在「Buff库」中配置" Foreground="#888" FontSize="12"/>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 公共CD检测 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="公共CD检测" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="检测公共CD进度条起始端的颜色，匹配时表示正在CD中" Foreground="#888" FontSize="12" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="检测点 (X, Y)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="2">
                                                <ui:TextBox Text="{Binding AppSettings.GlobalCdPoint[0]}" PlaceholderText="X" Margin="0,0,4,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.GlobalCdPoint[1]}" PlaceholderText="Y" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="取点" Height="32" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding SelectPointCommand}" CommandParameter="GlobalCd"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="CD进行中的颜色 (R, G, B)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="3">
                                                <ui:TextBox Text="{Binding AppSettings.GlobalCdColor[0]}" PlaceholderText="R" Margin="0,0,4,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.GlobalCdColor[1]}" PlaceholderText="G" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding AppSettings.GlobalCdColor[2]}" PlaceholderText="B" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="GlobalCdColorPreview" Width="32" Height="32" CornerRadius="4" Margin="8,0,0,0" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding GlobalCdPreviewColor}"/>
                                            </Border.Background>
                                        </Border>
                                        <ui:Button Grid.Column="2" Content="取色" Height="32" Margin="4,0,0,0" VerticalAlignment="Bottom" Command="{Binding PickGlobalCdColorCommand}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="颜色容差:" VerticalAlignment="Center"/>
                                        <ui:TextBox Text="{Binding AppSettings.GlobalCdColorTolerance}" Width="60" Margin="8,0,0,0"/>
                                        <ui:Button Content="测试" Height="32" Margin="16,0,0,0" Appearance="Info" Command="{Binding TestGlobalCdCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 全局快捷键设置 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="全局快捷键" FontSize="16" FontWeight="SemiBold"/>
                                        <ui:ToggleSwitch IsChecked="{Binding AppSettings.EnableGlobalHotkeys}" Content="启用" Margin="16,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="快捷键在游戏窗口中也能响应" Style="{StaticResource HintTextStyle}" Margin="0,0,0,12"/>
                                    
                                    <!-- 启动/停止快捷键 -->
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="启动/停止" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ComboBox Width="80" SelectedIndex="{Binding StartStopModifierIndex}" Margin="0,0,8,0">
                                                <ComboBoxItem Content="无"/>
                                                <ComboBoxItem Content="Ctrl"/>
                                                <ComboBoxItem Content="Alt"/>
                                                <ComboBoxItem Content="Shift"/>
                                            </ComboBox>
                                            <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#333" CornerRadius="4" Padding="12,6" MinWidth="60">
                                                <TextBlock Text="{Binding AppSettings.HotkeyStartStopKey, Converter={StaticResource KeyToName}}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Content="设置" Height="32" Margin="8,0,0,0" Command="{Binding CaptureHotkeyCommand}" CommandParameter="StartStop"/>
                                    </Grid>
                                    
                                    <!-- 暂停快捷键 -->
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="暂停/恢复" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ComboBox Width="80" SelectedIndex="{Binding PauseModifierIndex}" Margin="0,0,8,0">
                                                <ComboBoxItem Content="无"/>
                                                <ComboBoxItem Content="Ctrl"/>
                                                <ComboBoxItem Content="Alt"/>
                                                <ComboBoxItem Content="Shift"/>
                                            </ComboBox>
                                            <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#333" CornerRadius="4" Padding="12,6" MinWidth="60">
                                                <TextBlock Text="{Binding AppSettings.HotkeyPauseKey, Converter={StaticResource KeyToName}}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Content="设置" Height="32" Margin="8,0,0,0" Command="{Binding CaptureHotkeyCommand}" CommandParameter="Pause"/>
                                    </Grid>
                                    
                                    <ui:Button Content="重新注册快捷键" Command="{Binding ReregisterHotkeysCommand}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 配置导入导出 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="配置导入导出" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="导出配置可用于备份或分享给其他用户" Style="{StaticResource HintTextStyle}" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="导出全部配置" Command="{Binding ExportConfigCommand}" Margin="0,0,8,0">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUpload24"/></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="导入配置" Command="{Binding ImportConfigCommand}" Margin="0,0,8,0">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24"/></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="导出当前方案" Command="{Binding ExportProfileCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 保存按钮 -->
                            <ui:Button Content="保存设置" Appearance="Primary" Command="{Binding SaveSettingsCommand}" Height="44" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
