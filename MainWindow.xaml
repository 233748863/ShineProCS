<ui:FluentWindow x:Class="ShineProCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ShineProCS.ViewModels"
        xmlns:utils="clr-namespace:ShineProCS.Utils"
        x:Name="RootWindow"
        Title="ShineProCS - 游戏自动化引擎" Height="750" Width="1150"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <Window.Resources>
        <utils:InverseBooleanConverter x:Key="InvBool"/>
        <utils:KeyCodeToNameConverter x:Key="KeyToName"/>
        <utils:LogTextColorConverter x:Key="LogColorConverter"/>
        <utils:BoolToAddRemoveConverter x:Key="BoolToAddRemove"/>
        <utils:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="4,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <ui:TitleBar Title="ShineProCS - 游戏自动化引擎" Grid.Row="0"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧导航栏 -->
            <Border Background="#1a1a1a" Grid.Column="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
                        <TextBlock Text="快捷键" FontWeight="SemiBold" FontSize="11" Foreground="#999"/>
                        <TextBlock Text="Ctrl+Alt+F1 启动" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="Ctrl+Alt+F2 停止" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="Ctrl+Alt+F3 七情" FontSize="10" Foreground="#888"/>
                    </StackPanel>
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" SelectedIndex="0" ItemContainerStyle="{StaticResource NavItemStyle}">
                        <ListBoxItem Tag="status">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Target24" Margin="0,0,12,0"/>
                                <TextBlock Text="运行监控" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="skills">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Star24" Margin="0,0,12,0"/>
                                <TextBlock Text="技能配置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0"/>
                                <TextBlock Text="全局设置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>
            
            <!-- 右侧内容区 -->
            <Grid Grid.Column="1" Margin="16">
                <!-- 运行监控页 -->
                <Grid x:Name="StatusPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=NavList, Path=SelectedItem.Tag}" Value="status"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <!-- 引擎运行指标 -->
                    <ui:Card Grid.Column="0" Grid.Row="0" Margin="0,0,16,12">
                        <StackPanel>
                            <TextBlock Text="引擎运行指标" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <UniformGrid Columns="4">
                                <StackPanel><TextBlock Text="状态" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></StackPanel>
                                <StackPanel><TextBlock Text="执行次数" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding ExecutionCount}" FontWeight="Bold" FontSize="20"/></StackPanel>
                                <StackPanel><TextBlock Text="平均响应" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding AvgResponseTime, StringFormat={}{0:F1}ms}" FontWeight="Bold" FontSize="20"/></StackPanel>
                                <StackPanel><TextBlock Text="成功率" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding SuccessRate, StringFormat={}{0:F1}%}" FontWeight="Bold" FontSize="20" Foreground="#4CAF50"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding MemoryStats}" Foreground="#999" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- 技能状态面板 -->
                    <ui:Card Grid.Column="0" Grid.Row="1" Margin="0,0,16,12">
                        <StackPanel>
                            <TextBlock Text="技能实时状态" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding SkillStatusList}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,8,8" Padding="10,6" CornerRadius="6" MinWidth="100">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#333"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter Property="Background" Value="#2E7D32"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cooldown"><Setter Property="Background" Value="#F57C00"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NoBuff"><Setter Property="Background" Value="#C62828"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled"><Setter Property="Background" Value="#424242"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#CCC"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>

                    <!-- 运行日志 -->
                    <ui:Card Grid.Column="0" Grid.Row="2" Margin="0,0,16,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold"/>
                                <ui:Button Content="清空" Command="{Binding ClearLogsCommand}" HorizontalAlignment="Right" Appearance="Secondary"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding LogMessages}" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Converter={StaticResource LogColorConverter}}"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </ui:Card>

                    <!-- 控制中心 -->
                    <ui:Card Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="控制中心" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ui:Button Command="{Binding StartEngineCommand}" Appearance="Primary" Height="38" Margin="0,0,0,4" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}" Icon="{ui:SymbolIcon Play24}">
                                <ui:Button.Content><TextBlock Text="启动引擎" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <ui:Button Command="{Binding PauseEngineCommand}" Height="38" Margin="0,0,0,4" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning}" Icon="{ui:SymbolIcon Pause24}">
                                <ui:Button.Content><TextBlock Text="暂停/恢复" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <ui:Button Command="{Binding StopEngineCommand}" Height="38" Margin="0,0,0,4" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning}" Icon="{ui:SymbolIcon Stop24}">
                                <ui:Button.Content><TextBlock Text="停止引擎" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <Separator Margin="0,8"/>
                            <TextBlock Text="特殊模式" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:Button Command="{Binding ToggleQiQingModeCommand}" Height="32" Margin="0,0,0,2" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Sparkle24}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Content" Value="启用七情模式"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQiQingMode}" Value="True">
                                                <Setter Property="Content" Value="关闭七情模式"/>
                                                <Setter Property="Appearance" Value="Success"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <TextBlock Text="Ctrl+Alt+F3 切换" FontSize="10" Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <Separator Margin="0,4"/>
                            <ui:Button Command="{Binding ToggleOverlayCommand}" Height="30" Margin="0,0,0,4" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon WindowNew20}">
                                <ui:Button.Content><TextBlock Text="切换悬浮窗" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <ui:Button Command="{Binding ReloadConfigCommand}" Height="30" Margin="0,0,0,4" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowSync20}">
                                <ui:Button.Content><TextBlock Text="重新加载配置" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <ui:Button Command="{Binding ForceCleanupCommand}" Height="30" Margin="0,0,0,4" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Delete20}">
                                <ui:Button.Content><TextBlock Text="清理内存" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <Separator Margin="0,4"/>
                            <TextBlock Text="配置管理" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <ui:Button Command="{Binding ExportConfigCommand}" Height="28" Margin="0,0,0,4" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowExportUp20}">
                                <ui:Button.Content><TextBlock Text="导出配置" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                            <ui:Button Command="{Binding ImportConfigCommand}" Height="28" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowImport20}">
                                <ui:Button.Content><TextBlock Text="导入配置" Margin="4,0,0,0"/></ui:Button.Content>
                            </ui:Button>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- 技能配置页 -->
                <Grid x:Name="SkillsPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=NavList, Path=SelectedItem.Tag}" Value="skills"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <ui:Card Margin="0,0,16,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="技能执行流程" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="优先级：从上至下扫描" FontSize="12" Foreground="#999" Margin="0,4,0,0"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfile}"/>
                                    <ui:Button Grid.Column="1" Content="+" Width="32" Height="32" Margin="4,0,0,0" ToolTip="新建方案" Command="{Binding CreateProfileCommand}"/>
                                    <ui:Button Grid.Column="2" Content="−" Width="32" Height="32" Margin="4,0,0,0" ToolTip="删除当前方案" Command="{Binding DeleteProfileCommand}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <ui:Button Content="↑" Command="{Binding MoveSkillUpCommand}" Margin="2" Height="32" HorizontalAlignment="Stretch" ToolTip="上移技能"/>
                                    <ui:Button Grid.Column="1" Content="↓" Command="{Binding MoveSkillDownCommand}" Margin="2" Height="32" HorizontalAlignment="Stretch" ToolTip="下移技能"/>
                                </Grid>
                                <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <ui:Button Content="添加" Command="{Binding AddSkillCommand}" Margin="2" Height="32" HorizontalAlignment="Stretch"/>
                                    <ui:Button Grid.Column="1" Content="删除" Command="{Binding DeleteSkillCommand}" Margin="2" Height="32" HorizontalAlignment="Stretch"/>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <ui:Button Content="复制" Command="{Binding DuplicateSkillCommand}" Margin="2" Height="28" HorizontalAlignment="Stretch" ToolTip="复制选中技能"/>
                                    <ui:Button Grid.Column="1" Margin="2" Height="28" HorizontalAlignment="Stretch" ToolTip="批量操作">
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="全部启用" Command="{Binding EnableAllSkillsCommand}"/>
                                                <MenuItem Header="全部禁用" Command="{Binding DisableAllSkillsCommand}"/>
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="批量 ▼" FontSize="12"/></StackPanel>
                                    </ui:Button>
                                </Grid>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill}" Background="Transparent" BorderThickness="0" Margin="0,8" AlternationCount="100"
                                     utils:DragDropBehavior.EnableDragDrop="True"
                                     utils:DragDropBehavior.DragDropCompleted="SkillListBox_DragDropCompleted">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="拖拽可调整顺序"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), StringFormat={}{0}.}" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Background="#333" CornerRadius="4" Padding="6,2" Margin="4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KeyCode, Converter={StaticResource KeyToName}}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                    <CheckBox Grid.Column="3" IsChecked="{Binding Enabled}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <StackPanel DataContext="{Binding SelectedSkill}">
                                <TextBlock Text="技能参数配置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                <StackPanel>
                                    <!-- 基本信息 -->
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="技能名称" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="显示用的技能名称" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="按键绑定" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#333" CornerRadius="4" Padding="16,8" MinWidth="60">
                                                    <TextBlock Text="{Binding KeyCode, Converter={StaticResource KeyToName}}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                                </Border>
                                                <ui:Button Content="设置按键" Height="36" Margin="8,0,0,0" Command="{Binding DataContext.CaptureKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <TextBlock Text="点击按钮后按下要绑定的按键" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- 优先级 + 冷却 -->
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="优先级" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Priority}"/>
                                            <TextBlock Text="数字越大优先级越高" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="冷却时间 (秒)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Cooldown}"/>
                                            <TextBlock Text="技能冷却时间，0表示无冷却" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- 视觉检测区域 -->
                                    <TextBlock Text="视觉检测区域" FontWeight="Bold" Margin="0,8,0,0"/>
                                    <TextBlock Text="技能图标在屏幕上的位置，用于检测技能是否可用" FontSize="11" Foreground="#999" Margin="0,2,0,4"/>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <UniformGrid Columns="4">
                                            <ui:TextBox Text="{Binding IconRegion[0]}" PlaceholderText="X" Margin="0,0,4,0"/>
                                            <ui:TextBox Text="{Binding IconRegion[1]}" PlaceholderText="Y" Margin="2,0"/>
                                            <ui:TextBox Text="{Binding IconRegion[2]}" PlaceholderText="宽" Margin="2,0"/>
                                            <ui:TextBox Text="{Binding IconRegion[3]}" PlaceholderText="高" Margin="4,0,0,0"/>
                                        </UniformGrid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <ui:Button Content="框选" Height="32" Width="50" Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <ui:Button Content="预览" Height="32" Width="50" Margin="4,0,0,0" Command="{Binding DataContext.PreviewRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <ui:Button Content="⚡一键" Height="32" Margin="4,0,0,0" Appearance="Primary" Command="{Binding DataContext.QuickCaptureSkillTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- 模板图片路径 -->
                                    <TextBlock Text="模板图片路径" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBox Text="{Binding TemplatePath}" IsReadOnly="True"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <ui:Button Content="选择" Height="32" Width="50" Command="{Binding DataContext.SelectTemplateFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <ui:Button Content="截取" Height="32" Width="50" Margin="4,0,0,0" Command="{Binding DataContext.CaptureSkillTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <ui:Button Content="测试" Height="32" Width="50" Margin="4,0,0,0" Appearance="Info" Command="{Binding DataContext.TestTemplateMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="测试模板匹配，显示当前相似度"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- 释放条件（可选） -->
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="释放条件" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <ui:Button Content="添加" Command="{Binding DataContext.AddReleaseConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                   CommandParameter="{Binding}" Height="28" HorizontalAlignment="Right"
                                                   Visibility="{Binding ShowReleaseCondition, Converter={StaticResource InvBoolToVis}}"/>
                                    </DockPanel>
                                    <TextBlock Text="满足条件时才会释放该技能" FontSize="11" Foreground="#999" Margin="0,2,0,4"/>
                                    <Border Background="#222" CornerRadius="4" Padding="12" Margin="0,0,0,8" Visibility="{Binding ShowReleaseCondition, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <ui:Button Content="删除" Command="{Binding DataContext.RemoveReleaseConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           CommandParameter="{Binding}" Height="28" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="最低HP%" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <ui:TextBox Text="{Binding MinHp}"/>
                                                    <TextBlock Text="血量低于此值时才释放，0=不限制" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="最低MP%" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <ui:TextBox Text="{Binding MinMp}"/>
                                                    <TextBlock Text="蓝量低于此值时才释放，0=不限制" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 联动配置（可选） -->
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="联动配置（技能连招）" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <ui:Button Content="添加" Command="{Binding DataContext.AddComboConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                   CommandParameter="{Binding}" Height="28" HorizontalAlignment="Right"
                                                   Visibility="{Binding ShowComboConfig, Converter={StaticResource InvBoolToVis}}"/>
                                    </DockPanel>
                                    <TextBlock Text="缺少Buff时自动先释放前置技能" FontSize="11" Foreground="#999" Margin="0,2,0,4"/>
                                    <Border Background="#222" CornerRadius="4" Padding="12" Margin="0,0,0,8" Visibility="{Binding ShowComboConfig, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <ui:Button Content="删除" Command="{Binding DataContext.RemoveComboConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           CommandParameter="{Binding}" Height="28" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="触发条件Buff名称" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                                    <ui:TextBox Text="{Binding PreCastConditionBuff}" PlaceholderText="例如: 千枝态"/>
                                                    <TextBlock Text="缺少此Buff时触发联动" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="前置技能按键" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#333" CornerRadius="4" Padding="16,8" MinWidth="60">
                                                            <TextBlock Text="{Binding PreCastKeyCode, Converter={StaticResource KeyToName}}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <ui:Button Content="设置" Height="32" Margin="8,0,0,0" Command="{Binding DataContext.CapturePreCastKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="连招延迟 (毫秒)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                                <ui:TextBox Text="{Binding ComboDelay}" Width="150" HorizontalAlignment="Left" PlaceholderText="100"/>
                                                <TextBlock Text="前置技能释放后等待的时间" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Buff依赖要求 -->
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="Buff依赖要求" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <ui:Button Content="添加" Command="{Binding DataContext.AddBuffRequirementCommand, RelativeSource={RelativeSource AncestorType=Window}}" Height="28" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock Text="技能释放前需要检测的Buff状态" FontSize="11" Foreground="#999" Margin="0,2,0,4"/>
                                    <ItemsControl ItemsSource="{Binding BuffRequirements}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Background="#222" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Buff名称" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                            <ui:TextBox Text="{Binding Name}"/>
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="1" Content="删除" Command="{Binding DataContext.DeleteBuffRequirementCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Height="28" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                                                    </Grid>
                                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                                        <CheckBox IsChecked="{Binding IsRequired}" Content="必须存在" FontSize="12" Foreground="#DDD"/>
                                                        <CheckBox IsChecked="{Binding IsDebuff}" Content="是减益" FontSize="12" Foreground="#DDD"/>
                                                    </UniformGrid>
                                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <UniformGrid Columns="4">
                                                            <ui:TextBox Text="{Binding IconRegion[0]}" PlaceholderText="X" Margin="2"/>
                                                            <ui:TextBox Text="{Binding IconRegion[1]}" PlaceholderText="Y" Margin="2"/>
                                                            <ui:TextBox Text="{Binding IconRegion[2]}" PlaceholderText="宽" Margin="2"/>
                                                            <ui:TextBox Text="{Binding IconRegion[3]}" PlaceholderText="高" Margin="2"/>
                                                        </UniformGrid>
                                                        <ui:Button Grid.Column="1" Content="框选" Margin="8,0,0,0" Height="28" Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <ui:Button Grid.Column="2" Content="预览" Margin="4,0,0,0" Height="28" Command="{Binding DataContext.PreviewBuffRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="模板路径" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                            <ui:TextBox Text="{Binding TemplatePath}"/>
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="1" Content="选择" Margin="8,0,0,0" Height="28" VerticalAlignment="Bottom" Command="{Binding DataContext.SelectTemplateFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:Button Content="保存配置" Appearance="Primary" Command="{Binding DataContext.SaveConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,16,0,0" Height="44" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </ui:Card>
                </Grid>

                <!-- 全局设置页 -->
                <Grid x:Name="SettingsPage">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=NavList, Path=SelectedItem.Tag}" Value="settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel MaxWidth="700">
                            <TextBlock Text="全局设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
                            
                            <!-- 引擎设置 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="引擎设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="循环间隔 (毫秒)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Settings.LoopInterval}"/>
                                            <TextBlock Text="主循环检测间隔，建议50-200ms" Style="{StaticResource HintTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="按键间隔 (毫秒)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Settings.KeyPressInterval}"/>
                                            <TextBlock Text="连续按键之间的间隔" Style="{StaticResource HintTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="模板匹配阈值" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Settings.MatchThreshold}"/>
                                            <TextBlock Text="0.0-1.0，越高越严格，建议0.8" Style="{StaticResource HintTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="GC间隔 (秒)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Settings.GCIntervalSeconds}"/>
                                            <TextBlock Text="内存清理间隔，0=禁用" Style="{StaticResource HintTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 窗口捕获设置 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="窗口捕获设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="目标窗口标题" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding Settings.TargetWindowTitle}"/>
                                        <TextBlock Text="游戏窗口标题，支持部分匹配" Style="{StaticResource HintTextStyle}"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch IsChecked="{Binding Settings.UseWGC}" Content="使用 Windows Graphics Capture" Margin="0,0,0,8"/>
                                    <TextBlock Text="WGC性能更好，但需要Windows 10 1903+，关闭则使用BitBlt" Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- HP/MP检测区域 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="HP/MP 检测区域" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="HP条区域 (X, Y, 宽, 高)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="4">
                                                <ui:TextBox Text="{Binding Settings.HpRegion[0]}" PlaceholderText="X" Margin="0,0,4,0"/>
                                                <ui:TextBox Text="{Binding Settings.HpRegion[1]}" PlaceholderText="Y" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding Settings.HpRegion[2]}" PlaceholderText="宽" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding Settings.HpRegion[3]}" PlaceholderText="高" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="框选" Height="32" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding SelectHpRegionCommand}"/>
                                    </Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="MP条区域 (X, Y, 宽, 高)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="4">
                                                <ui:TextBox Text="{Binding Settings.MpRegion[0]}" PlaceholderText="X" Margin="0,0,4,0"/>
                                                <ui:TextBox Text="{Binding Settings.MpRegion[1]}" PlaceholderText="Y" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding Settings.MpRegion[2]}" PlaceholderText="宽" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding Settings.MpRegion[3]}" PlaceholderText="高" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="框选" Height="32" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding SelectMpRegionCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 气劲检测区域 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="气劲检测区域" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="千枝态检测区域" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="4">
                                                <ui:TextBox Text="{Binding Settings.QianZhiRegion[0]}" PlaceholderText="X" Margin="0,0,4,0"/>
                                                <ui:TextBox Text="{Binding Settings.QianZhiRegion[1]}" PlaceholderText="Y" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding Settings.QianZhiRegion[2]}" PlaceholderText="宽" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding Settings.QianZhiRegion[3]}" PlaceholderText="高" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="框选" Height="32" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding SelectQianZhiRegionCommand}"/>
                                    </Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="七情态检测区域" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <UniformGrid Columns="4">
                                                <ui:TextBox Text="{Binding Settings.QiQingRegion[0]}" PlaceholderText="X" Margin="0,0,4,0"/>
                                                <ui:TextBox Text="{Binding Settings.QiQingRegion[1]}" PlaceholderText="Y" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding Settings.QiQingRegion[2]}" PlaceholderText="宽" Margin="2,0"/>
                                                <ui:TextBox Text="{Binding Settings.QiQingRegion[3]}" PlaceholderText="高" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="框选" Height="32" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding SelectQiQingRegionCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 全局快捷键设置 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="全局快捷键" FontSize="16" FontWeight="SemiBold"/>
                                        <ui:ToggleSwitch IsChecked="{Binding AppSettings.EnableGlobalHotkeys}" Content="启用" Margin="16,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="快捷键在游戏窗口中也能响应" Style="{StaticResource HintTextStyle}" Margin="0,0,0,12"/>
                                    
                                    <!-- 启动/停止快捷键 -->
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="启动/停止" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ComboBox Width="80" SelectedIndex="{Binding StartStopModifierIndex}" Margin="0,0,8,0">
                                                <ComboBoxItem Content="无"/>
                                                <ComboBoxItem Content="Ctrl"/>
                                                <ComboBoxItem Content="Alt"/>
                                                <ComboBoxItem Content="Shift"/>
                                            </ComboBox>
                                            <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#333" CornerRadius="4" Padding="12,6" MinWidth="60">
                                                <TextBlock Text="{Binding AppSettings.HotkeyStartStopKey, Converter={StaticResource KeyToName}}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Content="设置" Height="32" Margin="8,0,0,0" Command="{Binding CaptureHotkeyCommand}" CommandParameter="StartStop"/>
                                    </Grid>
                                    
                                    <!-- 暂停快捷键 -->
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="暂停/恢复" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ComboBox Width="80" SelectedIndex="{Binding PauseModifierIndex}" Margin="0,0,8,0">
                                                <ComboBoxItem Content="无"/>
                                                <ComboBoxItem Content="Ctrl"/>
                                                <ComboBoxItem Content="Alt"/>
                                                <ComboBoxItem Content="Shift"/>
                                            </ComboBox>
                                            <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#333" CornerRadius="4" Padding="12,6" MinWidth="60">
                                                <TextBlock Text="{Binding AppSettings.HotkeyPauseKey, Converter={StaticResource KeyToName}}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Content="设置" Height="32" Margin="8,0,0,0" Command="{Binding CaptureHotkeyCommand}" CommandParameter="Pause"/>
                                    </Grid>
                                    
                                    <!-- 七情模式快捷键 -->
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="七情模式" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ComboBox Width="80" SelectedIndex="{Binding QiQingModifierIndex}" Margin="0,0,8,0">
                                                <ComboBoxItem Content="无"/>
                                                <ComboBoxItem Content="Ctrl"/>
                                                <ComboBoxItem Content="Alt"/>
                                                <ComboBoxItem Content="Shift"/>
                                            </ComboBox>
                                            <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#333" CornerRadius="4" Padding="12,6" MinWidth="60">
                                                <TextBlock Text="{Binding AppSettings.HotkeyQiQingKey, Converter={StaticResource KeyToName}}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Content="设置" Height="32" Margin="8,0,0,0" Command="{Binding CaptureHotkeyCommand}" CommandParameter="QiQing"/>
                                    </Grid>
                                    
                                    <ui:Button Content="重新注册快捷键" Command="{Binding ReregisterHotkeysCommand}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 配置导入导出 -->
                            <ui:Card Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="配置导入导出" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="导出配置可用于备份或分享给其他用户" Style="{StaticResource HintTextStyle}" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="导出全部配置" Command="{Binding ExportConfigCommand}" Margin="0,0,8,0">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUpload24"/></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="导入配置" Command="{Binding ImportConfigCommand}" Margin="0,0,8,0">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24"/></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="导出当前方案" Command="{Binding ExportProfileCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                            
                            <!-- 保存按钮 -->
                            <ui:Button Content="保存设置" Appearance="Primary" Command="{Binding SaveSettingsCommand}" Height="44" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
