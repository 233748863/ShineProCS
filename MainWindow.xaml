<ui:FluentWindow x:Class="ShineProCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
        xmlns:vm="clr-namespace:ShineProCS.ViewModels"
        xmlns:utils="clr-namespace:ShineProCS.Utils"
        xmlns:pages="clr-namespace:ShineProCS.Views.Pages"
        x:Name="RootWindow"
        Title="ShineProCS - 游戏自动化引擎" 
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <!-- 需求 1.1: 使用 FluentWindow 作为基础窗口类型，启用 ExtendsContentIntoTitleBar -->
    <!-- 需求 7.3: DataContext 通过构造函数注入设置 -->
    
    <Window.Resources>
        <utils:InverseBooleanConverter x:Key="InvBool"/>
        <utils:KeyCodeToNameConverter x:Key="KeyToName"/>
        <utils:LogTextColorConverter x:Key="LogColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <utils:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 需求 1.6: 标题栏显示应用程序标题，提供最小化到托盘功能 -->
        <ui:TitleBar Title="ShineProCS - 游戏自动化引擎" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Target24"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- 主题切换按钮 -->
                    <ui:Button Width="40" Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               CornerRadius="0"
                               Command="{Binding SwitchThemeCommand}"
                               ToolTip="切换深浅主题">
                        <ui:SymbolIcon Symbol="WeatherMoon24"/>
                    </ui:Button>
                    <!-- 最小化到托盘按钮 -->
                    <ui:Button Width="40" Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               CornerRadius="0"
                               Command="{Binding MinimizeToTrayCommand}"
                               ToolTip="最小化到托盘">
                        <ui:SymbolIcon Symbol="CaretDown24"/>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 需求 1.2: 左侧显示可折叠的 NavigationView 导航组件 -->
        <!-- 需求 2.2: 使用 NavigationCacheMode.Enabled 缓存页面 -->
        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           Margin="0,0,0,5"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="180"
                           PaneDisplayMode="Left">
            
            <!-- 需求 1.4: 导航视图包含菜单项：启动、技能配置、Buff库 -->
            <!-- 需求 2.5: 支持嵌套菜单项以分组相关功能 -->
            <ui:NavigationView.MenuItems>
                <!-- 启动页 (Home) -->
                <ui:NavigationViewItem Content="启动"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:HomePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Play24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- 配置管理 - 嵌套菜单示例 (需求 2.5) -->
                <ui:NavigationViewItem Content="配置管理">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Options24"/>
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <!-- 技能配置页 (Skills) -->
                        <ui:NavigationViewItem Content="技能配置"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type pages:SkillsPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Star24"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>

                        <!-- Buff库页 (Buffs) -->
                        <ui:NavigationViewItem Content="Buff库"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type pages:BuffsPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Shield24"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <!-- 需求 1.5: 导航视图在底部显示设置入口 -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="设置"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- 通知显示区域 -->
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter"/>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- 需求 1.7, 12.1-12.5: 系统托盘集成 -->
        <tray:NotifyIcon Grid.Row="0"
                         x:Name="TrayIcon"
                         FocusOnLeftClick="False"
                         LeftDoubleClick="OnNotifyIconLeftDoubleClick"
                         MenuOnRightClick="True"
                         TooltipText="{Binding TrayTooltip}">
            <tray:NotifyIcon.Menu>
                <!-- ContextMenu 不在可视化树中，通过代码后台设置 DataContext -->
                <ContextMenu x:Name="TrayContextMenu">
                    <!-- 需求 12.3: 托盘右键菜单选项 -->
                    <ui:MenuItem Header="显示窗口" x:Name="TrayMenuShowWindow"
                                 Icon="{ui:SymbolIcon Window24}"/>
                    <Separator/>
                    <ui:MenuItem Header="启动/停止引擎" x:Name="TrayMenuToggleEngine"
                                 Icon="{ui:SymbolIcon Play24}"/>
                    <ui:MenuItem Header="暂停/恢复" x:Name="TrayMenuPause"
                                 Icon="{ui:SymbolIcon Pause24}"/>
                    <Separator/>
                    <ui:MenuItem Header="检查更新" x:Name="TrayMenuCheckUpdate"
                                 Icon="{ui:SymbolIcon ArrowSync24}"/>
                    <ui:MenuItem Header="退出" x:Name="TrayMenuExit"
                                 Icon="{ui:SymbolIcon Dismiss24}"/>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
