<Window x:Class="ShineProCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:ShineProCS.ViewModels"
        xmlns:utils="clr-namespace:ShineProCS.Utils"
        x:Name="RootWindow"
        Title="ShineProCS - 游戏自动化引擎" Height="750" Width="1150"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}">

    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <Window.Resources>
        <utils:InverseBooleanConverter x:Key="InvBool"/>
        <utils:KeyCodeToNameConverter x:Key="KeyToName"/>
        <utils:LogTextColorConverter x:Key="LogColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 统一的说明文字样式 -->
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="SectionDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ui:NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="180">
            <ui:NavigationView.Header>
                <TextBlock Text="ShineProCS - 游戏自动化引擎" Style="{DynamicResource TitleTextBlockStyle}" Margin="12,0,0,0" FontSize="22"/>
            </ui:NavigationView.Header>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="运行监控" Tag="status" IsSelected="True"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Target"/></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
                <ui:NavigationViewItem Content="技能配置" Tag="skills"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Favorite"/></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
                <ui:NavigationViewItem Content="全局设置" Tag="settings"><ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Setting"/></ui:NavigationViewItem.Icon></ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.Content>
                <Grid Margin="16">
                    <!-- 运行监控页 -->
                    <Grid x:Name="StatusPage">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=Nav, Path=SelectedItem.Tag}" Value="status"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                        <!-- 引擎运行指标 -->
                        <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Padding="20" Margin="0,0,16,12">
                            <StackPanel>
                                <TextBlock Text="引擎运行指标" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,16"/>
                                <UniformGrid Columns="4">
                                    <StackPanel><TextBlock Text="状态" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"/></StackPanel>
                                    <StackPanel><TextBlock Text="执行次数" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding ExecutionCount}" FontWeight="Bold" FontSize="20"/></StackPanel>
                                    <StackPanel><TextBlock Text="平均响应" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding AvgResponseTime, StringFormat={}{0:F4}s}" FontWeight="Bold" FontSize="20"/></StackPanel>
                                    <StackPanel><TextBlock Text="成功率" Foreground="#999" FontSize="12"/><TextBlock Text="{Binding SuccessRate, StringFormat={}{0:F1}%}" FontWeight="Bold" FontSize="20" Foreground="#4CAF50"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding MemoryStats}" Foreground="#999" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 技能状态面板 (新增) -->
                        <Border Grid.Column="0" Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Padding="16" Margin="0,0,16,12">
                            <StackPanel>
                                <TextBlock Text="技能实时状态" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding SkillStatusList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,8,8" Padding="10,6" CornerRadius="6" MinWidth="100">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#333"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                                <Setter Property="Background" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cooldown">
                                                                <Setter Property="Background" Value="#F57C00"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="NoBuff">
                                                                <Setter Property="Background" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                                <Setter Property="Background" Value="#424242"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StatusIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#CCC"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 运行日志 -->
                        <Border Grid.Column="0" Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="运行日志" Style="{DynamicResource SubtitleTextBlockStyle}"/><Button Content="清空" Command="{Binding ClearLogsCommand}" HorizontalAlignment="Right" Height="28"/></DockPanel>
                                <ListBox ItemsSource="{Binding LogMessages}" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{Binding Converter={StaticResource LogColorConverter}}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- 控制中心 -->
                        <Border Grid.Column="1" Grid.RowSpan="3" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Padding="20" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="控制中心" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,16"/>
                                <Button Content="启动引擎" Command="{Binding StartEngineCommand}" Style="{DynamicResource AccentButtonStyle}" Height="44" Margin="0,0,0,8" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}"/>
                                <Button Content="暂停/恢复" Command="{Binding PauseEngineCommand}" Height="44" Margin="0,0,0,8" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning}"/>
                                <Button Content="停止引擎" Command="{Binding StopEngineCommand}" Height="44" Margin="0,0,0,8" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning}"/>
                                <Separator Margin="0,16"/>
                                <TextBlock Text="特殊模式" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Button Command="{Binding ToggleQiQingModeCommand}" Height="36" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="Content" Value="启用七情模式"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQiQingMode}" Value="True">
                                                    <Setter Property="Content" Value="关闭七情模式"/>
                                                    <Setter Property="Background" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="Ctrl+Alt+F3 切换" FontSize="10" Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Separator Margin="0,8"/>
                                <Button Content="切换悬浮窗" Command="{Binding ToggleOverlayCommand}" Height="36" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                                <Button Content="重新加载配置" Command="{Binding ReloadConfigCommand}" Height="36" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                                <Button Content="清理内存" Command="{Binding ForceCleanupCommand}" Height="36" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                                <Separator Margin="0,8"/>
                                <TextBlock Text="配置管理" FontWeight="SemiBold" Margin="0,8,0,8"/>
                                <Button Content="导出配置" Command="{Binding ExportConfigCommand}" Height="32" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
                                <Button Content="导入配置" Command="{Binding ImportConfigCommand}" Height="32" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 技能配置页 -->
                    <Grid x:Name="SkillsPage">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=Nav, Path=SelectedItem.Tag}" Value="skills"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Margin="0,0,16,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                                    <TextBlock Text="技能执行流程" Style="{DynamicResource SubtitleTextBlockStyle}" FontSize="16"/>
                                    <TextBlock Text="优先级：从上至下扫描" FontSize="12" Foreground="#999" Margin="0,4,0,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfile}" ui:ControlHelper.Header="配置方案" Margin="0,12,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="8">
                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button Content="↑" Command="{Binding MoveSkillUpCommand}" Margin="2" Height="32" HorizontalAlignment="Stretch" ToolTip="上移技能"/>
                                        <Button Grid.Column="1" Content="↓" Command="{Binding MoveSkillDownCommand}" Margin="2" Height="32" HorizontalAlignment="Stretch" ToolTip="下移技能"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button Content="添加" Command="{Binding AddSkillCommand}" Margin="2" Height="32" HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="删除" Command="{Binding DeleteSkillCommand}" Margin="2" Height="32" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button Content="复制" Command="{Binding DuplicateSkillCommand}" Margin="2" Height="28" HorizontalAlignment="Stretch" ToolTip="复制选中技能"/>
                                        <Button Grid.Column="1" Margin="2" Height="28" HorizontalAlignment="Stretch" ToolTip="批量操作">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="全部启用" Command="{Binding EnableAllSkillsCommand}"/>
                                                    <MenuItem Header="全部禁用" Command="{Binding DisableAllSkillsCommand}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="批量 ▼" FontSize="12"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Skills}" SelectedItem="{Binding SelectedSkill}" Background="Transparent" BorderThickness="0" Margin="4,0" AlternationCount="100"
                                         utils:DragDropBehavior.EnableDragDrop="True"
                                         utils:DragDropBehavior.DragDropCompleted="SkillListBox_DragDropCompleted">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="ToolTip" Value="拖拽可调整顺序"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), StringFormat={}{0}.}" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" CornerRadius="4" Padding="6,2" Margin="4,0">
                                            <TextBlock Text="{Binding KeyCode, Converter={StaticResource KeyToName}}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <CheckBox Grid.Column="3" IsChecked="{Binding Enabled}" Margin="4,0,0,0"/>
                                    </Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedSkill}">
                                    <TextBlock Text="技能参数配置" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,16" FontSize="18"/>
                                    <ui:SimpleStackPanel Spacing="12">
                                        <!-- 基本信息：技能名称 + 按键绑定 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.Header="技能名称"/>
                                                <TextBlock Text="显示用的技能名称" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="按键绑定" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" CornerRadius="4" Padding="16,8" VerticalAlignment="Center" MinWidth="60">
                                                        <TextBlock Text="{Binding KeyCode, Converter={StaticResource KeyToName}}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"/>
                                                    </Border>
                                                    <Button Content="设置按键" Height="36" Margin="8,0,0,0" Command="{Binding DataContext.CaptureKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <TextBlock Text="点击按钮后按下要绑定的按键" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- 优先级 + 冷却时间 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBox Text="{Binding Priority}" ui:ControlHelper.Header="优先级"/>
                                                <TextBlock Text="数字越大优先级越高" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBox Text="{Binding Cooldown}" ui:ControlHelper.Header="冷却时间 (秒)"/>
                                                <TextBlock Text="技能冷却时间，0表示无冷却" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- 视觉检测区域 -->
                                        <TextBlock Text="视觉检测区域" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock Text="技能图标在屏幕上的位置，用于检测技能是否可用" FontSize="11" Foreground="#999" Margin="0,2,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <UniformGrid Columns="4">
                                                <TextBox Text="{Binding IconRegion[0]}" ui:ControlHelper.Header="X" Margin="0,0,4,0"/>
                                                <TextBox Text="{Binding IconRegion[1]}" ui:ControlHelper.Header="Y" Margin="2,0"/>
                                                <TextBox Text="{Binding IconRegion[2]}" ui:ControlHelper.Header="宽" Margin="2,0"/>
                                                <TextBox Text="{Binding IconRegion[3]}" ui:ControlHelper.Header="高" Margin="4,0,0,0"/>
                                            </UniformGrid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Bottom">
                                                <Button Content="框选" Height="32" Width="50" Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="框选检测区域"/>
                                                <Button Content="预览" Height="32" Width="50" Margin="4,0,0,0" Command="{Binding DataContext.PreviewRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="预览当前区域"/>
                                                <Button Content="⚡一键" Height="32" Margin="4,0,0,0" Command="{Binding DataContext.QuickCaptureSkillTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="一键框选并截取模板" Style="{DynamicResource AccentButtonStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- 模板图片路径 -->
                                        <StackPanel>
                                            <TextBlock Text="模板图片路径" FontSize="12" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding TemplatePath}" IsReadOnly="True" ToolTip="{Binding TemplatePath}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <Button Content="选择" Height="32" Width="50" Command="{Binding DataContext.SelectTemplateFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="选择模板图片"/>
                                                    <Button Content="截取" Height="32" Width="50" Margin="4,0,0,0" Command="{Binding DataContext.CaptureSkillTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="从当前区域截取模板"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="技能图标的模板图片，用于图像匹配检测" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- 释放条件 -->
                                        <TextBlock Text="释放条件" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock Text="满足条件时才会释放该技能" FontSize="11" Foreground="#999" Margin="0,2,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBox Text="{Binding MinHp}" ui:ControlHelper.Header="最低HP%"/>
                                                <TextBlock Text="血量低于此值时才释放，0=不限制" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBox Text="{Binding MinMp}" ui:ControlHelper.Header="最低MP%"/>
                                                <TextBlock Text="蓝量低于此值时才释放，0=不限制" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <!-- 联动配置 -->
                                        <TextBlock Text="联动配置（技能连招）" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock Text="场景：当角色缺少某个Buff时，自动先释放前置技能获取Buff，再释放本技能" FontSize="11" Foreground="#999" Margin="0,2,0,4"/>
                                        <Border Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" CornerRadius="4" Padding="12">
                                            <StackPanel>
                                                <!-- 第一行：触发条件Buff + 前置技能按键 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- 左：触发条件Buff -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="触发条件Buff名称" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding PreCastConditionBuff}" ui:ControlHelper.PlaceholderText="例如: 千枝态"/>
                                                        <TextBlock Text="填写Buff名称，缺少此Buff时触发联动" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    
                                                    <!-- 右：前置技能按键 -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="前置技能按键" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4" Padding="16,8" MinWidth="60">
                                                                <TextBlock Text="{Binding PreCastKeyCode, Converter={StaticResource KeyToName}}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <Button Content="设置" Height="32" Margin="8,0,0,0" Command="{Binding DataContext.CapturePreCastKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="缺少Buff时先释放此按键的技能" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- 第二行：连招延迟 -->
                                                <StackPanel Margin="0,12,0,0">
                                                    <TextBlock Text="连招延迟 (毫秒)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding ComboDelay}" Width="150" HorizontalAlignment="Left" ui:ControlHelper.PlaceholderText="100"/>
                                                    <TextBlock Text="前置技能释放后等待的时间，再释放本技能" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                
                                                <!-- 示例说明 -->
                                                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="💡 示例：赤芍寒香 需要 千枝态 Buff" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"/>
                                                        <TextBlock Text="触发条件Buff = 千枝态，前置技能 = W键（千枝绽蕊）" FontSize="11" Foreground="#AAA" Margin="0,2,0,0"/>
                                                        <TextBlock Text="→ 缺少千枝态时，先按W释放千枝绽蕊，等待后再释放赤芍寒香" FontSize="11" Foreground="#AAA" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Buff依赖要求 -->
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock Text="Buff依赖要求" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Content="添加" Command="{Binding DataContext.AddBuffRequirementCommand, RelativeSource={RelativeSource AncestorType=Window}}" Height="28" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="技能释放前需要检测的Buff状态" FontSize="11" Foreground="#999" Margin="0,2,0,4"/>
                                        <ItemsControl ItemsSource="{Binding BuffRequirements}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                                    <ui:SimpleStackPanel Spacing="8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding Name}" ui:ControlHelper.Header="Buff名称" Margin="0,0,8,0"/>
                                                            <Button Grid.Column="1" Content="删除" Command="{Binding DataContext.DeleteBuffRequirementCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Height="28" VerticalAlignment="Bottom"/>
                                                        </Grid>
                                                        <UniformGrid Columns="2">
                                                            <CheckBox IsChecked="{Binding IsRequired}" Content="必须存在" FontSize="12" Foreground="#DDD"/>
                                                            <CheckBox IsChecked="{Binding IsDebuff}" Content="是减益" FontSize="12" Foreground="#DDD"/>
                                                        </UniformGrid>
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <UniformGrid Columns="4"><TextBox Text="{Binding IconRegion[0]}" ui:ControlHelper.Header="X" Margin="2"/><TextBox Text="{Binding IconRegion[1]}" ui:ControlHelper.Header="Y" Margin="2"/><TextBox Text="{Binding IconRegion[2]}" ui:ControlHelper.Header="宽" Margin="2"/><TextBox Text="{Binding IconRegion[3]}" ui:ControlHelper.Header="高" Margin="2"/></UniformGrid>
                                                            <Button Grid.Column="1" Content="框选" VerticalAlignment="Bottom" Margin="8,0,0,0" Height="28" Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            <Button Grid.Column="2" Content="预览" VerticalAlignment="Bottom" Margin="4,0,0,0" Height="28" Command="{Binding DataContext.PreviewBuffRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Grid>
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding TemplatePath}" ui:ControlHelper.Header="模板路径"/>
                                                            <Button Grid.Column="1" Content="选择" VerticalAlignment="Bottom" Margin="8,0,0,0" Height="28" Command="{Binding DataContext.SelectTemplateFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </ui:SimpleStackPanel>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="保存配置" Style="{DynamicResource AccentButtonStyle}" Command="{Binding DataContext.SaveConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,16,0,0" Height="44" HorizontalAlignment="Stretch"/>
                                    </ui:SimpleStackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- 全局设置页 -->
                    <Grid x:Name="SettingsPage">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=Nav, Path=SelectedItem.Tag}" Value="settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Padding="24" VerticalAlignment="Top">
                            <StackPanel DataContext="{Binding AppSettings}">
                                <TextBlock Text="全局设置" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,16"/>
                                
                                <!-- 开关选项 - 三列 -->
                                <UniformGrid Columns="3" Margin="0,0,0,16">
                                    <StackPanel Margin="0,0,16,0">
                                        <ui:ToggleSwitch Header="启用智能模式" IsOn="{Binding EnableSmartMode}"/>
                                        <TextBlock Text="自动调整技能释放策略" FontSize="10" Foreground="#999" Margin="0,-4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <ui:ToggleSwitch Header="启用WGC截图" IsOn="{Binding EnableWgcCapture}"/>
                                        <TextBlock Text="高效截图，需Win10 1803+" FontSize="10" Foreground="#999" Margin="0,-4,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <ui:ToggleSwitch Header="启用悬浮窗" IsOn="{Binding EnableOverlay}"/>
                                        <TextBlock Text="游戏窗口显示状态" FontSize="10" Foreground="#999" Margin="0,-4,0,0"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- 基础参数 - 三列 -->
                                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="循环间隔(ms)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding LoopInterval}" Width="140" HorizontalAlignment="Left"/>
                                        <TextBlock Text="技能检测间隔时间" FontSize="10" Foreground="#999"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="日志级别(0-3)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding LogLevel}" Width="140" HorizontalAlignment="Left"/>
                                        <TextBlock Text="0关闭 1错误 2信息 3调试" FontSize="10" Foreground="#999"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="游戏窗口标题(可选)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding GameWindowTitle}"/>
                                        <TextBlock Text="留空自动检测前台窗口，填写可锁定指定窗口" FontSize="10" Foreground="#999"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 区域设置 - 两列布局 -->
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="检测区域" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <UniformGrid Columns="4"><TextBox Text="{Binding DetectionRegion[0]}" ui:ControlHelper.Header="X" Margin="1"/><TextBox Text="{Binding DetectionRegion[1]}" ui:ControlHelper.Header="Y" Margin="1"/><TextBox Text="{Binding DetectionRegion[2]}" ui:ControlHelper.Header="宽" Margin="1"/><TextBox Text="{Binding DetectionRegion[3]}" ui:ControlHelper.Header="高" Margin="1"/></UniformGrid>
                                            <Button Grid.Column="1" Content="框选" VerticalAlignment="Bottom" Margin="4,0,0,0" Height="32" Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Detection"/>
                                            <Button Grid.Column="2" Content="预览" VerticalAlignment="Bottom" Margin="4,0,0,0" Height="32" Command="{Binding DataContext.PreviewSettingsRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Detection"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="血条检测区域" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <UniformGrid Columns="4"><TextBox Text="{Binding HealthBarRegion[0]}" ui:ControlHelper.Header="X" Margin="1"/><TextBox Text="{Binding HealthBarRegion[1]}" ui:ControlHelper.Header="Y" Margin="1"/><TextBox Text="{Binding HealthBarRegion[2]}" ui:ControlHelper.Header="宽" Margin="1"/><TextBox Text="{Binding HealthBarRegion[3]}" ui:ControlHelper.Header="高" Margin="1"/></UniformGrid>
                                            <Button Grid.Column="1" Content="框选" VerticalAlignment="Bottom" Margin="4,0,0,0" Height="32" Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="HealthBar"/>
                                            <Button Grid.Column="2" Content="预览" VerticalAlignment="Bottom" Margin="4,0,0,0" Height="32" Command="{Binding DataContext.PreviewSettingsRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="HealthBar"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="蓝条检测区域" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <UniformGrid Columns="4"><TextBox Text="{Binding ManaBarRegion[0]}" ui:ControlHelper.Header="X" Margin="1"/><TextBox Text="{Binding ManaBarRegion[1]}" ui:ControlHelper.Header="Y" Margin="1"/><TextBox Text="{Binding ManaBarRegion[2]}" ui:ControlHelper.Header="宽" Margin="1"/><TextBox Text="{Binding ManaBarRegion[3]}" ui:ControlHelper.Header="高" Margin="1"/></UniformGrid>
                                            <Button Grid.Column="1" Content="框选" VerticalAlignment="Bottom" Margin="4,0,0,0" Height="32" Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="ManaBar"/>
                                            <Button Grid.Column="2" Content="预览" VerticalAlignment="Bottom" Margin="4,0,0,0" Height="32" Command="{Binding DataContext.PreviewSettingsRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="ManaBar"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="公共CD检测点" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding GlobalCdPoint[0]}" ui:ControlHelper.Header="X" Margin="1"/>
                                            <TextBox Grid.Column="1" Text="{Binding GlobalCdPoint[1]}" ui:ControlHelper.Header="Y" Margin="1"/>
                                            <Button Grid.Column="2" Content="点选" VerticalAlignment="Bottom" Margin="4,0,0,0" Height="32" Command="{Binding DataContext.SelectPointCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="GlobalCd"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Button Content="保存设置" Style="{DynamicResource AccentButtonStyle}" Command="{Binding DataContext.SaveConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,20,0,0" Height="40" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ui:NavigationView.Content>
            
            <!-- 底部快捷键提示栏 -->
            <ui:NavigationView.PaneFooter>
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="12,8" Margin="4">
                    <StackPanel>
                        <TextBlock Text="快捷键" FontWeight="SemiBold" FontSize="11" Foreground="#999" Margin="0,0,0,4"/>
                        <TextBlock Text="Ctrl+Alt+F1 启动" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="Ctrl+Alt+F2 停止" FontSize="10" Foreground="#888"/>
                        <TextBlock Text="Ctrl+Alt+F3 七情" FontSize="10" Foreground="#888"/>
                    </StackPanel>
                </Border>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>
        
        <!-- 首次使用引导提示 -->
        <Border x:Name="GuideTip" Background="#E6333333" CornerRadius="8" Padding="16" 
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"
                Visibility="{Binding ShowGuideTip, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💡" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="首次使用提示" FontWeight="Bold" Foreground="White" FontSize="14"/>
                    <TextBlock Text="请先在「全局设置」中框选检测区域，然后在「技能配置」中设置技能按键" 
                               Foreground="#CCC" FontSize="12" TextWrapping="Wrap" MaxWidth="400"/>
                </StackPanel>
                <Button Content="知道了" Margin="16,0,0,0" VerticalAlignment="Center" 
                        Command="{Binding DismissGuideTipCommand}" Height="28"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
