<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    
    <!-- ========================================
         ShineProCS 全局样式资源
         需求 13.1, 13.2, 13.3, 13.4, 13.5
         ======================================== -->
    
    <!-- ========== 颜色定义 ========== -->
    <!-- 主题色 -->
    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentColorLight">#429CE3</Color>
    <Color x:Key="AccentColorDark">#005A9E</Color>
    
    <!-- 状态色 -->
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="WarningColor">#FF9800</Color>
    <Color x:Key="ErrorColor">#F44336</Color>
    <Color x:Key="InfoColor">#2196F3</Color>
    
    <!-- 背景色 -->
    <Color x:Key="CardBackgroundColor">#252525</Color>
    <Color x:Key="CardBackgroundHoverColor">#2D2D2D</Color>
    <Color x:Key="SurfaceColor">#1A1A1A</Color>
    <Color x:Key="BorderColor">#333333</Color>
    
    <!-- 文字色 -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#999999</Color>
    <Color x:Key="TextTertiaryColor">#666666</Color>
    <Color x:Key="TextDisabledColor">#444444</Color>
    
    <!-- 画刷定义 -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentColorLight}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentColorDark}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    
    <!-- ========== 间距常量 ========== -->
    <!-- 需求 13.3: 统一间距 -->
    <Thickness x:Key="PageMargin">24,16,24,16</Thickness>
    <Thickness x:Key="CardMargin">0,0,0,16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SectionMargin">0,0,0,12</Thickness>
    <Thickness x:Key="ItemMargin">0,0,0,8</Thickness>
    <Thickness x:Key="SmallMargin">0,0,0,4</Thickness>
    
    <!-- 间距值 -->
    <sys:Double x:Key="SpacingXS" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>
    <sys:Double x:Key="SpacingSM" xmlns:sys="clr-namespace:System;assembly=mscorlib">8</sys:Double>
    <sys:Double x:Key="SpacingMD" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="SpacingLG" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="SpacingXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    
    <!-- ========== 字体样式 ========== -->
    <!-- 需求 13.3: 统一字体 -->
    <FontFamily x:Key="DefaultFontFamily">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Courier New, monospace</FontFamily>
    
    <!-- 字体大小 -->
    <sys:Double x:Key="FontSizeXS" xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>
    <sys:Double x:Key="FontSizeSM" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="FontSizeMD" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="FontSizeLG" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSizeXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="FontSizeXXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    
    <!-- ========== 文本样式 ========== -->
    <!-- 页面标题样式 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>
    
    <!-- 卡片标题样式 -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXL}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    
    <!-- 节标题样式 -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXXL}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    
    <!-- 字段标签样式 -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    
    <!-- 提示文本样式 -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <!-- 验证错误文本样式 -->
    <Style x:Key="ValidationErrorStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    
    <!-- 等宽字体显示样式 -->
    <Style x:Key="MonoDisplayStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <!-- 次要文本样式 -->
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    
    <!-- 禁用文本样式 -->
    <Style x:Key="DisabledTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
    </Style>
    
    <!-- ========== 状态徽章样式 ========== -->
    <!-- 成功状态徽章 -->
    <Style x:Key="SuccessBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>
    
    <!-- 警告状态徽章 -->
    <Style x:Key="WarningBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>
    
    <!-- 错误状态徽章 -->
    <Style x:Key="ErrorBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>
    
    <!-- 信息状态徽章 -->
    <Style x:Key="InfoBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>
    
    <!-- 计数徽章样式 -->
    <Style x:Key="CountBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#333"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <!-- ========== 卡片项样式 ========== -->
    <!-- 列表项容器样式 -->
    <Style x:Key="ListItemContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    
    <!-- 预览区域样式 -->
    <Style x:Key="PreviewAreaStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="180"/>
    </Style>
    
    <!-- 信息面板样式 -->
    <Style x:Key="InfoPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    
    <!-- 警告面板样式 -->
    <Style x:Key="WarningPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#3D2020"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    
    <!-- ========== 按钮高度常量 ========== -->
    <sys:Double x:Key="ButtonHeightSM" xmlns:sys="clr-namespace:System;assembly=mscorlib">28</sys:Double>
    <sys:Double x:Key="ButtonHeightMD" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <sys:Double x:Key="ButtonHeightLG" xmlns:sys="clr-namespace:System;assembly=mscorlib">38</sys:Double>
    <sys:Double x:Key="ButtonHeightXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">44</sys:Double>
    
</ResourceDictionary>
